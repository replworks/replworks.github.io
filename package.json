{
  "name": "tmp",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "toolbar:start": "astro preferences enable devToolbar",
    "toolbar:stop": "astro preferences disable devToolbar",
    "dev:stop": "astro dev stop",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check \"**/*.{ts,tsx,astro}\"",
    "test": "vitest run && playwright test",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "build": "astro build",
    "preview": "astro preview",
    "og:yml": "node scripts/og-yml.mjs",
    "og": "astro build && (astro preview & PID=$!; sleep 3; npm run og:yml && shot-scraper multi og.yml; kill $PID)",
    "astro": "astro",
    "astro:check": "astro check"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/sitemap": "^3.7.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@expressive-code/plugin-frames": "^0.44.2",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@typescript-eslint/parser": "^8.71.0",
    "astro": "^7.3.5",
    "astro-broken-links-checker": "^1.1.0",
    "astro-expressive-code": "^0.44.2",
    "astro-pagefind": "^2.0.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.3"
  }
}
