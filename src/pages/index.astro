---
import HomeLayout from '../layouts/HomeLayout.astro';
import ShowcaseCard from '../components/ShowcaseCard.astro';
import { showcaseProjects } from '../data/showcase';

// 문서 6종 2단계 그룹 데이터
const stage1Docs = [
  { id: '01', file: 'IDEAS.md', desc: '아이디어 검증' },
  { id: '02', file: 'PITCHING_SCRIPT.md', desc: '프로젝트 포지셔닝' },
];

const stage2Docs = [
  { id: '03', file: 'PRODUCT_SPEC.md', desc: '제품 정의' },
  { id: '04', file: 'TECH_STACK.md', desc: '기술 구현 규칙' },
  { id: '05', file: 'ARCHITECTURE.md', desc: '시스템 설계' },
  { id: '06', file: 'TASKS.md', desc: '수행 계획' },
];

// 다섯 가지 핵심 기반 데이터 (순서: 프로젝트 지속성 보장 -> 특정 AI 의존성 탈피)
const benefits = [
  {
    num: '01',
    title: '프로젝트 지속성 보장',
    desc: '세션이 끝나거나 담당자가 변경되어도 제품의 원래 의도와 기술적 결정 사항이 사라지지 않고 코드베이스에 보존됩니다.',
  },
  {
    num: '02',
    title: '특정 AI 의존성 탈피',
    desc: '프로젝트의 모든 기억과 설계가 Git에 존재하므로 Claude, GPT, Gemini 등 어떤 모델로 교체해도 문서를 읽고 작업을 곧바로 이어받습니다.',
  },
  {
    num: '03',
    title: 'AI 토큰 및 비용 최적화',
    desc: '수만 줄의 이전 채팅 로그나 수십 개 파일 전체를 굶기지 않고, 현재 작업(TASK)에 필요한 해당 상위 문서만 효율적으로 입력합니다.',
  },
  {
    num: '04',
    title: '팀 & AI 온보딩 비용 제로',
    desc: '새로운 개발자나 에이전트가 투입되어도 표준 문서 순서대로 파악하여 몇 분 만에 사이드 이펙트 없는 개발을 시작합니다.',
  },
  {
    num: '05',
    title: 'Git 단일 진실 출처 (Single Source of Truth)',
    desc: '현재 시스템 상태는 문서가 설명하고, 과거의 의사결정 이력은 Git 커밋으로 추적 가능하여 구조가 흔들리지 않습니다.',
  },
];
---

<HomeLayout
  title="REPL Works — 문서 주도 AI 개발 방법론"
  description="REPL Works는 프로젝트의 목적, 기술 규칙, 구조를 문서 몇 개로 정리해 Git에 두는 개발 방식입니다. 새 채팅을 열어도, 다른 AI로 바꿔도, AI가 그 문서부터 읽고 이어서 작업합니다."
>
  <div class="mx-auto flex max-w-7xl flex-col gap-20 sm:gap-28 text-slate-100">
    {/* =========================================================================
      1. PROBLEM
      ========================================================================= */}
    <section class="space-y-6">
      <div class="flex items-center gap-2">
        <span class="h-2 w-2 rounded-full bg-red-400"></span>
        <p class="text-xs font-mono font-black tracking-widest text-red-400 uppercase">
          PROBLEM
        </p>
      </div>
      <h2 class="text-3xl sm:text-4xl font-black tracking-tight text-white">
        새 채팅마다 설명하고,
        <br class="hidden sm:inline" /> AI는 엉뚱한 곳에 코드를 씁니다
      </h2>
      <p class="max-w-3xl text-sm sm:text-base leading-relaxed text-slate-300">
        새 채팅마다 프로젝트를 처음부터 설명합니다. AI가 엉뚱한 버전이나 폴더에
        코드를 넣습니다.
      </p>

      <div class="mt-8 grid gap-4 md:grid-cols-2">
        {[
          {
            num: '01',
            title: '새 채팅마다 프로젝트를 처음부터 설명합니다',
            desc: '세션이 끊기면 프로젝트의 목적과 지금까지의 결정을 다시 설명해야 합니다.',
          },
          {
            num: '02',
            title: 'AI가 엉뚱한 버전이나 폴더에 코드를 넣습니다',
            desc: 'AI가 프로젝트의 기술 규칙과 폴더 구조를 모르면 코드를 잘못된 곳에 작성합니다.',
          },
        ].map((item) => (
          <article class="glass-card glass-card-hover rounded-2xl p-6 border-slate-800/80 bg-slate-900/40 relative overflow-hidden group">
            <div class="absolute top-0 right-0 w-24 h-24 bg-red-500/5 rounded-full blur-xl group-hover:bg-red-500/10 transition-all"></div>
            <p class="text-xs font-mono font-black text-red-400">{item.num}</p>
            <h3 class="mt-3 text-base font-extrabold text-white">
              {item.title}
            </h3>
            <p class="mt-2 text-xs text-slate-400 leading-relaxed">
              {item.desc}
            </p>
          </article>
        ))}
      </div>
    </section>

    {/* =========================================================================
      2. WORKFLOW: REPL Works는 어떻게 작동하는가
      ========================================================================= */}
    <section class="space-y-8 border-t border-slate-800/80 pt-16">
      <div class="space-y-4">
        <div class="flex items-center gap-2">
          <span class="h-2 w-2 rounded-full bg-cyan-400"></span>
          <p class="text-xs font-mono font-black tracking-widest text-cyan-400 uppercase">
            HOW IT WORKS
          </p>
        </div>
        <h2 class="text-3xl sm:text-4xl font-black tracking-tight text-white">
          REPL Works는 어떻게 작동하는가
        </h2>
        <p class="max-w-3xl text-sm sm:text-base leading-relaxed text-slate-300">
          6개 문서는 모두 대화형 AI와 사람이 함께 작성합니다. 코딩형 AI는 개발
          전에 2단계 문서를 스스로 검증하고 수정하며, 개발 중에도 코드와 문서를
          함께 수정합니다. 사람은 변경분을 검토하고 커밋합니다.
        </p>
      </div>

      {/* Two Group Document Architecture */}
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch pt-2">
        {/* Stage 1 Group */}
        <div class="lg:col-span-4 glass-card rounded-2xl p-6 border-indigo-500/30 bg-indigo-950/20 flex flex-col justify-between space-y-4">
          <div>
            <div class="flex items-center justify-between mb-4 pb-3 border-b border-indigo-800/40">
              <span class="text-xs font-mono font-bold text-indigo-400 uppercase tracking-wider">
                1단계 · 사람을 위한 문서
              </span>
              <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-indigo-900/60 text-indigo-200 border border-indigo-700/50">
                2종
              </span>
            </div>
            <div class="space-y-3">
              {stage1Docs.map((doc) => (
                <div class="p-3.5 rounded-xl border border-indigo-800/40 bg-slate-900/60 flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <span class="text-xs font-mono font-black text-indigo-400">
                      {doc.id}
                    </span>
                    <span class="font-mono font-bold text-sm text-white">
                      {doc.file}
                    </span>
                  </div>
                  <span class="text-xs text-slate-400">{doc.desc}</span>
                </div>
              ))}
            </div>
          </div>
          <p class="text-xs text-indigo-300/80 leading-relaxed pt-2">
            사람이 비즈니스 동기와 핵심 방향을 잡고 대화형 AI와 함께 정의하는
            단계입니다.
          </p>
        </div>

        {/* Stage 2 Group */}
        <div class="lg:col-span-8 glass-card rounded-2xl p-6 border-cyan-500/30 bg-cyan-950/20 flex flex-col justify-between space-y-4">
          <div>
            <div class="flex items-center justify-between mb-4 pb-3 border-b border-cyan-800/40">
              <span class="text-xs font-mono font-bold text-cyan-400 uppercase tracking-wider">
                2단계 · AI를 위한 문서
              </span>
              <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-cyan-900/60 text-cyan-200 border border-cyan-700/50">
                4종
              </span>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              {stage2Docs.map((doc) => (
                <div class="p-3.5 rounded-xl border border-cyan-800/40 bg-slate-900/60 flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <span class="text-xs font-mono font-black text-cyan-400">
                      {doc.id}
                    </span>
                    <span class="font-mono font-bold text-sm text-white">
                      {doc.file}
                    </span>
                  </div>
                  <span class="text-xs text-slate-400">{doc.desc}</span>
                </div>
              ))}
            </div>
          </div>
          <p class="text-xs text-cyan-300/80 leading-relaxed pt-2">
            코딩형 AI가 개발 전 문서를 검증하고 1-Task 1-Commit 단위로 코드와
            문서를 함께 수정합니다.
          </p>
        </div>
      </div>

      <div class="pt-2 flex justify-start">
        <a
          href="/workflow"
          class="inline-flex items-center gap-2 px-5 py-3 text-xs font-bold text-cyan-300 bg-cyan-950/60 border border-cyan-800/60 rounded-xl hover:bg-cyan-900/80 hover:text-white transition-all"
        >
          <span>전체 워크플로 상세 문서 보기</span>
          <svg
            class="h-4 w-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2.5"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M14 5l7 7m0 0l-7 7m7-7H3"
            />
          </svg>
        </a>
      </div>
    </section>

    {/* =========================================================================
      3. FIVE FOUNDATION BENEFITS
      ========================================================================= */}
    <section class="border-t border-slate-800/80 pt-16 space-y-8">
      <div>
        <div class="flex items-center gap-2">
          <span class="h-2 w-2 rounded-full bg-indigo-400"></span>
          <p class="text-xs font-mono font-black tracking-widest text-indigo-400 uppercase">
            SYSTEMIC ADVANTAGES
          </p>
        </div>
        <h2 class="mt-2 text-2xl sm:text-3xl font-black tracking-tight text-white">
          지속 가능한 개발을 완성하는 5가지 기반
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {benefits.map((b) => (
          <article class="glass-card glass-card-hover rounded-2xl p-6 border-slate-800/80 bg-slate-900/30 space-y-3">
            <span class="text-xs font-mono font-black text-indigo-400">
              {b.num}
            </span>
            <h3 class="text-base font-extrabold text-white">{b.title}</h3>
            <p class="text-xs text-slate-400 leading-relaxed">{b.desc}</p>
          </article>
        ))}
      </div>
    </section>

    {/* =========================================================================
      4. SHOWCASE PROJECTS
      ========================================================================= */}
    <section class="border-t border-slate-800/80 pt-16 space-y-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
        <div>
          <div class="flex items-center gap-2">
            <span class="h-2 w-2 rounded-full bg-cyan-400"></span>
            <p class="text-xs font-mono font-black tracking-widest text-cyan-400 uppercase">
              COMPATIBLE ECOSYSTEM
            </p>
          </div>
          <h2 class="mt-2 text-2xl sm:text-3xl font-black tracking-tight text-white">
            REPL Works 호환 프로덕트 사례
          </h2>
        </div>
        <a
          href="/showcase"
          class="inline-flex items-center justify-center px-4 py-2 text-xs font-extrabold text-slate-200 bg-slate-900 border border-slate-700/80 rounded-xl hover:bg-slate-800 hover:text-white transition-all w-fit"
        >
          전체 아카이브 보기
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {showcaseProjects
          .filter((project) => project.featured)
          .sort((a, b) => a.order - b.order)
          .map((project) => (
            <ShowcaseCard project={project} />
          ))}
      </div>
    </section>

    {/* =========================================================================
      5. CORE IDEA BOTTOM CTA CARD
      ========================================================================= */}
    <section class="border-t border-slate-800/80 pt-16 pb-8">
      <div class="glass-card rounded-3xl p-8 sm:p-12 border-cyan-500/30 bg-gradient-to-br from-cyan-950/40 via-slate-950 to-indigo-950/40 text-center relative overflow-hidden shadow-2xl">
        <div class="absolute -right-20 -bottom-20 w-80 h-80 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>
        <span class="text-xs font-mono font-black uppercase tracking-[0.3em] text-cyan-400">
          CORE PHILOSOPHY
        </span>
        <h2 class="mt-4 text-3xl sm:text-5xl font-black text-white tracking-tight">
          Models change.
          <br />
          <span class="text-gradient-cyan">Projects survive.</span>
        </h2>
        <p class="mt-4 max-w-xl mx-auto text-sm text-slate-300 leading-relaxed">
          AI 모델의 한계를 극복하는 것은 더 큰 맥락창이 아니라, Git과 표준
          문서로 지켜지는 단단한 프로젝트 기억 자산입니다.
        </p>
        <div class="mt-8 flex justify-center items-center gap-4">
          <a
            href="/documents"
            class="px-6 py-3.5 text-xs font-black text-slate-950 bg-gradient-to-r from-cyan-400 to-emerald-400 rounded-xl shadow-lg shadow-cyan-500/20 hover:scale-105 transition-all"
          >
            REPL Works 표준 시작하기
          </a>
        </div>
      </div>
    </section>
  </div>
</HomeLayout>
