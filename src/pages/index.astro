---
import HomeLayout from '../layouts/HomeLayout.astro';

// 코어 워크플로 파이프라인 데이터
const pipelineSteps = [
  { id: '01', file: 'IDEAS.md', desc: '아이디어 검증' },
  { id: '02', file: 'PITCHING_SCRIPT.md', desc: '프로젝트 포지셔닝' },
  { id: '03', file: 'PRODUCT_SPEC.md', desc: '제품 정의' },
  { id: '04', file: 'TECH_STACK.md', desc: '기술 구현 규칙' },
  { id: '05', file: 'ARCHITECTURE.md', desc: '시스템 설계' },
  { id: '06', file: 'TASKS.md', desc: '수행 계획' },
];

// 다섯 가지 핵심 기반 데이터
const benefits = [
  {
    title: '특정 AI 의존성 탈피',
    desc: '프로젝트 기억이 Git에 있어 새로운 모델도 이어서 작업합니다.',
  },
  {
    title: '프로젝트 지속성',
    desc: '세션이 끝나도 의도와 구조가 문서로 남습니다.',
  },
  {
    title: 'AI 입력 비용 최적화',
    desc: '오래된 채팅 로그 대신 필요한 문서만 읽힙니다.',
  },
  {
    title: '온보딩 비용 절감',
    desc: '새 팀원과 새 AI 모두 문서를 읽고 바로 시작합니다.',
  },
  {
    title: 'Git 기반 워크플로',
    desc: '현재 상태는 문서가, 과거 상태는 커밋이 보존합니다.',
  },
];

// 쇼케이스 프로젝트 데이터
const showcases = [
  {
    title: 'REPL Works 웹사이트',
    desc: 'ReplWorks 웹사이트는 본 프레임워크를 실제로 적용하여 관리 중인 첫 번째 REPL Works 호환 프로덕션 프로젝트입니다.',
    tags: ['Website', 'Dogfooding'],
    link: '/showcase/repl-works-website',
    github: 'https://github.com/replworks/replworks.github.io',
  },
  {
    title: 'AI 이슈 퍼블리셔',
    desc: 'AI 에이전트와의 토론 컨텍스트를 분석하여, 즉시 개발 및 실행 가능한 GitHub Issue 형태로 자동 변환해 주는 호환 도구입니다.',
    tags: ['Tooling', 'Issue workflow'],
    link: '/showcase/ai-issue',
    github: 'https://github.com/replworks/ai-issue',
  },
  {
    title: '클래이튜브(ClayTube)',
    desc: 'ClayTube는 장기간에 걸쳐 지속적으로 기능이 개발되고 확장되는 과정을 검증하는 데 초점을 둔 참조 프로젝트입니다.',
    tags: ['CLI', 'Website Generator'],
    link: '/showcase/claytube',
    github: 'https://github.com/eternops/claytube',
  },
  {
    title: '와이파이 노트(WIFI Note)',
    desc: '구조화된 프로젝트 기억 자산화를 통해 복잡한 비즈니스 로직을 빌드해 나가는 과정을 보여주는 웹 애플리케이션 프로젝트입니다.',
    tags: ['Commercial', 'Web App'],
    link: '/showcase/wifi-note',
  },
];
---

<HomeLayout
  title="REPL Works — 문서 주도 AI 개발 방법론"
  description="REPL Works는 프로젝트의 의도, 결정, 작업 계획을 문서와 Git에 남겨 AI가 바뀌어도 개발을 이어가는 문서 주도 AI 개발 방법론입니다."
>
  <div class="mx-auto flex max-w-5xl flex-col gap-16 px-4 sm:gap-24 md:px-6">
    <section class="order-1 border-b border-slate-100 py-4">
      <p class="text-xs font-black tracking-widest text-slate-400 uppercase font-mono">METHOD</p>
      <h2 class="mt-2 text-2xl font-black tracking-tight text-slate-900 sm:text-3xl">
        작업을 쪼개고, 규칙은 문서로 둡니다
      </h2>
      <p class="mt-3 max-w-2xl text-sm leading-relaxed text-slate-600">
        AI에게 큰 일을 한 번에 시키면 앞의 결정을 잊고 구조가 흔들립니다. REPL Works는 일을 TASKS로 쪼개고, TASK마다 필요한 규칙을 상위 문서에서 가져오게 합니다. 규칙은 채팅이 아니라 Git에 있으므로 AI가 바뀌어도 같은 기준으로 이어집니다.
      </p>
      <div class="mt-8 grid gap-3 md:grid-cols-3">
        {[
          '상위 문서에 규칙을 남긴다',
          '작업을 TASKS로 쪼갠다',
          'AI가 TASK 하나씩, 해당 규칙만 읽고 실행한다',
        ].map((title, index) => (
          <article class="rounded-2xl border border-slate-200/70 bg-slate-50/40 p-5 transition-all hover:border-slate-300 hover:bg-white hover:shadow-sm">
            <p class="text-xs font-mono font-bold text-slate-400">0{index + 1}</p>
            <h3 class="mt-3 text-sm font-extrabold leading-relaxed text-slate-800">{title}</h3>
          </article>
        ))}
      </div>
    </section>
    {
      /* =========================================================================
        2. WORKFLOW SECTION
        ========================================================================= */
    }
    <section
      class="order-2 grid gap-8 border-b border-slate-100 pb-16 lg:grid-cols-[0.8fr_1.2fr] lg:items-start"
    >
      <div>
        <p
          class="text-xs font-black tracking-widest text-slate-400 uppercase font-mono"
        >
          Workflow
        </p>
        <h2
          class="mt-2 text-2xl sm:text-3xl font-black tracking-tight text-slate-900"
        >
          REPL Works는 어떻게 작동하는가
        </h2>
        <p class="mt-3 text-sm text-slate-600 leading-relaxed">
          위 문서에서 아래 문서가 파생되는 단계형 파이프라인입니다. 앞 단계가 정해져야 다음 단계를 씁니다.
        </p>
      </div>

      <div class="space-y-6">
        {/* 세로 타임라인 트랙 트레일 */}
        <div
          class="relative pl-5 my-2 before:absolute before:top-2 before:bottom-2 before:left-[9px] before:w-0.5 before:bg-slate-200"
        >
          {
            pipelineSteps.map((step) => (
              <div class="relative mb-4 last:mb-0 group flex items-center min-w-0">
                {/* 불릿 원 노드 포인트 */}
                <span class="absolute -left-[21px] flex h-3.5 w-3.5 items-center justify-center rounded-full bg-white border-2 border-slate-300 group-hover:border-slate-900 transition-colors z-10">
                  <span class="h-1 w-1 rounded-full bg-slate-300 group-hover:bg-slate-900 transition-colors" />
                </span>

                {/* 콘텐츠 행 래퍼 (찌그러짐 원천 차단) */}
                <div class="flex items-center gap-2 sm:gap-3 w-full min-w-0 text-slate-700">
                  {/* 정렬용 ID 번호 */}
                  <span class="text-[10px] font-mono font-bold text-slate-400 select-none w-3 shrink-0 text-right">
                    {step.id}
                  </span>

                  {/* 파일명 시그니처 칩 */}
                  <span class="inline-block px-2 py-0.5 text-[10px] sm:text-[11px] font-black font-mono bg-slate-950 text-slate-100 rounded border border-slate-900 shadow-sm tracking-tight select-none shrink-0">
                    {step.file}
                  </span>

                  {/* 데스크톱 가로 연결 화살표 */}
                  <svg
                    class="hidden sm:block h-3.5 w-3.5 text-slate-300 shrink-0"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="2.5"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"
                    />
                  </svg>

                  {/* 한글 기능 가이드 설명 */}
                  <p class="text-[11px] sm:text-xs font-extrabold text-slate-600 tracking-tight min-w-0 whitespace-normal break-words">
                    <span class="sm:hidden text-slate-300 mr-1 font-normal">
                      ·
                    </span>
                    {step.desc}
                  </p>
                </div>
              </div>
            ))
          }
        </div>

        <p class="text-xs sm:text-sm leading-relaxed text-slate-500">
          REPL Works 아키텍처는 프로젝트 기억 문서 자산화에서 시작해 Discussion
          AI, Execution AI를 거쳐 최종 Human Review 파이프라인으로 연결됩니다.
        </p>

        <a
          href="/workflow"
          class="inline-flex items-center justify-center px-4 py-2 text-xs font-black text-slate-700 bg-white border border-slate-200 rounded-xl shadow-sm hover:bg-slate-50 hover:text-slate-900 hover:border-slate-300 transition-all shrink-0 w-fit"
        >
          워크플로 구조 문서 상세 보기
        </a>
      </div>
    </section>

    {
      /* =========================================================================
        3. PROBLEM SECTION
        ========================================================================= */
    }
    <section class="order-2 py-4">
      <span
        class="text-xs font-black tracking-widest text-slate-400 uppercase font-mono block mb-1"
        >WORKFLOW</span
      >
      <h2 class="text-2xl font-black text-slate-900 tracking-tight mb-2">
        이 문서들이 답하는 네 가지 질문
      </h2>
      {/* 2x2 대시보드 그리드 큐브 카드 구조 */}
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 my-6">
        <div
          class="flex items-start gap-3 p-4 rounded-2xl border border-slate-200/70 bg-slate-50/40 hover:bg-white hover:border-slate-300 hover:shadow-sm transition-all group"
        >
          <span
            class="text-xs font-mono font-bold text-slate-400 mt-0.5 group-hover:text-slate-900 transition-colors"
            >Q1</span
          >
          <div class="space-y-0.5">
            <h3 class="text-sm font-extrabold text-slate-800 tracking-tight">
              왜 만드는가?
            </h3>
            <p class="text-xs text-slate-500 tracking-tight">
              프로젝트의 본질적인 도메인 목적과 비즈니스 동기
            </p>
            <p class="text-xs font-mono text-slate-400">IDEAS.md, PITCHING_SCRIPT.md</p>
          </div>
        </div>

        <div
          class="flex items-start gap-3 p-4 rounded-2xl border border-slate-200/70 bg-slate-50/40 hover:bg-white hover:border-slate-300 hover:shadow-sm transition-all group"
        >
          <span
            class="text-xs font-mono font-bold text-slate-400 mt-0.5 group-hover:text-slate-900 transition-colors"
            >Q2</span
          >
          <div class="space-y-0.5">
            <h3 class="text-sm font-extrabold text-slate-800 tracking-tight">
              무엇을 만드는가?
            </h3>
            <p class="text-xs text-slate-500 tracking-tight">
              제품의 스펙 사양 정의 및 상세 요구사항 기능 규격
            </p>
            <p class="text-xs font-mono text-slate-400">PRODUCT_SPEC.md</p>
          </div>
        </div>

        <div
          class="flex items-start gap-3 p-4 rounded-2xl border border-slate-200/70 bg-slate-50/40 hover:bg-white hover:border-slate-300 hover:shadow-sm transition-all group"
        >
          <span
            class="text-xs font-mono font-bold text-slate-400 mt-0.5 group-hover:text-slate-900 transition-colors"
            >Q3</span
          >
          <div class="space-y-0.5">
            <h3 class="text-sm font-extrabold text-slate-800 tracking-tight">
              현재 구조는 무엇인가?
            </h3>
            <p class="text-xs text-slate-500 tracking-tight">
              전체 시스템의 구조와 컴포넌트 관계
            </p>
            <p class="text-xs font-mono text-slate-400">TECH_STACK.md, ARCHITECTURE.md</p>
          </div>
        </div>

        <div
          class="flex items-start gap-3 p-4 rounded-2xl border border-slate-200/70 bg-slate-50/40 hover:bg-white hover:border-slate-300 hover:shadow-sm transition-all group"
        >
          <span
            class="text-xs font-mono font-bold text-slate-400 mt-0.5 group-hover:text-slate-900 transition-colors"
            >Q4</span
          >
          <div class="space-y-0.5">
            <h3 class="text-sm font-extrabold text-slate-800 tracking-tight">
              어떤 결정을 내렸는가?
            </h3>
            <p class="text-xs text-slate-500 tracking-tight">
              지금까지 누적 도출된 테크니컬 마일스톤과 설계 의사결정 이력
            </p>
            <p class="text-xs font-mono text-slate-400">TASKS.md, Git 커밋 이력</p>
          </div>
        </div>
      </div>

      <p class="text-xs sm:text-sm text-slate-500 leading-relaxed mt-4">
        이 네 질문의 답을 상위 문서로 남기고 Git으로 이력을 관리합니다. TASK마다 필요한 규칙은 이 문서에서 가져옵니다.
      </p>
    </section>

    {
      /* =========================================================================
        4. BENEFITS SECTION
        ========================================================================= */
    }
    <section
      class="order-4 grid gap-8 border-t border-slate-200 pt-12 lg:grid-cols-[0.8fr_1.2fr] lg:items-start"
    >
      <div>
        <p
          class="text-xs font-black tracking-widest text-slate-400 uppercase font-mono"
        >
          Benefits
        </p>
        <h2
          class="mt-2 text-2xl sm:text-3xl font-black tracking-tight text-slate-900"
        >
          프로젝트를 계속할 수 있게 만드는 다섯 가지 기반
        </h2>
      </div>

      <div class="space-y-8">
        {
          benefits.map((benefit) => (
            <article class="border-l-2 border-slate-200 hover:border-slate-900 pl-5 transition-colors group">
              <h3 class="text-base sm:text-lg font-black text-slate-800 tracking-tight group-hover:text-slate-950 transition-colors">
                {benefit.title}
              </h3>
              <p class="mt-2 text-xs sm:text-sm text-slate-600 leading-relaxed font-medium">
                {benefit.desc}
              </p>
            </article>
          ))
        }
      </div>
    </section>

    {
      /* =========================================================================
        5. SHOWCASE SECTION
        ========================================================================= */
    }
    <section
      class="order-3 grid gap-8 border-t border-slate-200 pt-12 lg:grid-cols-[0.8fr_1.2fr] lg:items-start"
    >
      <div>
        <p
          class="text-xs font-black tracking-widest text-slate-400 uppercase font-mono"
        >
          Showcase
        </p>
        <h2
          class="mt-2 text-2xl sm:text-3xl font-black tracking-tight text-slate-900"
        >
          REPL Works 호환 프로젝트
        </h2>
        <p class="mt-3 text-sm text-slate-600 leading-relaxed">
          REPL Works를 실제 프로젝트에 적용한 사례입니다.
        </p>
        <a
          href="/showcase"
          class="mt-6 inline-flex items-center justify-center px-4 py-2 text-xs font-black text-slate-700 bg-white border border-slate-200 rounded-xl shadow-sm hover:bg-slate-50 hover:text-slate-900 hover:border-slate-300 transition-all shrink-0 w-fit"
        >
          전체 쇼케이스 아카이브 보기
        </a>
      </div>

      <div class="space-y-4 w-full">
        {
          showcases.map((project) => (
            <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm hover:border-slate-300 hover:shadow-md transition-all duration-200">
              {/* 프로젝트 유형 테그 그룹 */}
              <div class="flex flex-wrap items-center gap-1.5 text-[10px] font-bold uppercase tracking-wider font-mono">
                {project.tags.map((tag, idx) => (
                  <span
                    class={`inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold ${idx === 0 ? 'bg-blue-50 text-blue-700 border border-blue-100' : 'bg-slate-50 text-slate-600 border border-slate-200/60'}`}
                  >
                    {tag}
                  </span>
                ))}
              </div>

              <h3 class="mt-3 text-base sm:text-lg font-black text-slate-900 tracking-tight">
                {project.title}
              </h3>
              <p class="mt-2 text-xs sm:text-sm text-slate-600 leading-relaxed font-medium">
                {project.desc}
              </p>

              {/* 실행 링크 버튼 그룹 */}
              <div class="mt-4 flex items-center gap-2">
                <a
                  href={project.link}
                  class="inline-flex items-center justify-center px-3 py-1.5 text-xs font-extrabold text-slate-700 bg-slate-50 border border-slate-200 rounded-lg hover:bg-slate-100 hover:text-slate-900 transition-colors"
                >
                  상세 정보
                </a>
                {project.github && (
                  <a
                    href={project.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center justify-center px-3 py-1.5 text-xs font-extrabold text-slate-700 bg-slate-50 border border-slate-200 rounded-lg hover:bg-slate-100 hover:text-slate-900 transition-colors"
                  >
                    GitHub 소스
                  </a>
                )}
              </div>
            </article>
          ))
        }
      </div>
    </section>

    {
      /* =========================================================================
        6. CORE IDEA FOOTER CARD
        ========================================================================= */
    }
    <section
      class="order-5 my-4 rounded-2xl border border-slate-200 bg-slate-950 p-6 text-slate-50 shadow-sm sm:p-8"
    >
      <p
        class="text-xs font-semibold uppercase tracking-[0.3em] text-slate-400 font-mono"
      >
        Core Idea
      </p>
      <div
        class="mt-4 font-mono text-sm leading-relaxed text-slate-100 bg-slate-900/40 p-4 rounded-xl border border-slate-800/80 max-w-sm select-none"
      >
        <p class="font-black text-white text-base tracking-tight">
          Models forget.
        </p>
        <p
          class="text-slate-400 font-extrabold text-base tracking-tight mt-0.5"
        >
          Projects must not.
        </p>
      </div>
    </section>
  </div>
</HomeLayout>
