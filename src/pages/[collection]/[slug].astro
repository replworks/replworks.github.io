---
import type { ContentCollection } from '../../lib/site';
import {
  contentCollections,
  collectionTitles,
  collectionLabels,
  isContentCollection,
} from '../../lib/site';
import { getCollection, getEntry, render } from 'astro:content';
import DocumentLayout from '../../layouts/DocumentLayout.astro';
import PromptDetailHeader from '../../components/PromptDetailHeader.astro';
import PromptSource from '../../components/PromptSource.astro';
import CollectionSidebar from '../../components/CollectionSidebar.astro';
import { promptDefinitions } from '../../data/prompts';
import { getPromptSource } from '../../utils/promptSource';

export async function getStaticPaths() {
  const paths: Array<{
    params: { collection: ContentCollection; slug: string };
  }> = [];

  for (const collection of contentCollections) {
    const entries = await getCollection(collection);
    paths.push(
      ...entries.map((entry) => ({ params: { collection, slug: entry.id } })),
    );
  }

  return paths;
}

const collection = Astro.params.collection;
const slug = Astro.params.slug;
if (!isContentCollection(collection)) {
  throw new Error(`Unsupported collection: ${collection}`);
}

const entry = await getEntry(collection, slug);
if (!entry) {
  throw new Error(`Entry not found for ${collection}/${slug}`);
}

const rendered = entry.rendered ?? null;
const contentResult = !rendered ? await render(entry) : null;
const Content = contentResult?.Content ?? null;
const metadata = entry.data ?? {};

const promptDef =
  collection === 'prompts'
    ? (promptDefinitions.find((p) => p.slug === slug) ?? null)
    : null;
const promptText = promptDef ? getPromptSource(promptDef.slug) : null;
---

<DocumentLayout
  title={metadata.title ?? collectionTitles[collection]}
  label={metadata.label ?? collectionLabels[collection]}
  description={
    metadata.description ?? `${collectionTitles[collection]} document.`
  }
>
  <div class="grid grid-cols-1 gap-8 lg:grid-cols-12">
    <div class="lg:col-span-8 space-y-6">
      {promptDef && <PromptDetailHeader prompt={promptDef} />}

      {rendered ? (
        <div class="space-y-6">
          <article
            set:html={rendered.html}
            class="space-y-6 text-slate-700 dark:text-slate-200"
          />
          {promptText && <PromptSource promptText={promptText} />}
        </div>
      ) : Content ? (
        <article class="space-y-6 text-slate-700 dark:text-slate-200">
          <Content />
          {promptText && <PromptSource promptText={promptText} />}
        </article>
      ) : (
        <div class="rounded-3xl border border-dashed border-slate-300 bg-slate-50 p-8 text-slate-700">
          <p>This document is available once the collection publish content.</p>
        </div>
      )}
    </div>

    <div class="lg:col-span-4">
      <div class="lg:sticky lg:top-24">
        <CollectionSidebar collection={collection} currentSlug={slug} />
      </div>
    </div>
  </div>
</DocumentLayout>
