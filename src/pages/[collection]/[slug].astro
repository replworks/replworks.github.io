---
import type { ContentCollection } from '../../lib/site';
import {
  contentCollections,
  collectionTitles,
  collectionLabels,
  isContentCollection,
} from '../../lib/site';
import { getCollection, getEntry, render } from 'astro:content';
import DocumentLayout from '../../layouts/DocumentLayout.astro';
import PromptDetailHeader from '../../components/PromptDetailHeader.astro';
import { promptDefinitions } from '../../data/prompts';

export async function getStaticPaths() {
  const paths: Array<{
    params: { collection: ContentCollection; slug: string };
  }> = [];

  for (const collection of contentCollections) {
    const entries = await getCollection(collection);
    paths.push(
      ...entries.map((entry) => ({ params: { collection, slug: entry.id } })),
    );
  }

  return paths;
}

const collection = Astro.params.collection;
const slug = Astro.params.slug;
if (!isContentCollection(collection)) {
  throw new Error(`Unsupported collection: ${collection}`);
}

const entry = await getEntry(collection, slug);
if (!entry) {
  throw new Error(`Entry not found for ${collection}/${slug}`);
}

const rendered = entry.rendered ?? null;
const contentResult = !rendered ? await render(entry) : null;
const Content = contentResult?.Content ?? null;
const metadata = entry.data ?? {};

const promptDef =
  collection === 'prompts'
    ? (promptDefinitions.find((p) => p.slug === slug) ?? null)
    : null;
---

<DocumentLayout
  title={metadata.title ?? collectionTitles[collection]}
  label={metadata.label ?? collectionLabels[collection]}
  description={
    metadata.description ?? `${collectionTitles[collection]} document.`
  }
>
  {promptDef && <PromptDetailHeader prompt={promptDef} />}

  {rendered ? (
    <article set:html={rendered.html} class="space-y-6 text-slate-200" />
  ) : Content ? (
    <article class="space-y-6 text-slate-200">
      <Content />
    </article>
  ) : (
    <div class="rounded-3xl border border-dashed border-slate-300 bg-slate-50 p-8 text-slate-700">
      <p>This document is available once the collection publish content.</p>
    </div>
  )}
</DocumentLayout>

<script>
  // Add copy button to top-right of markdown code blocks
  document.addEventListener('DOMContentLoaded', () => {
    const codeBlocks = document.querySelectorAll('article pre');

    codeBlocks.forEach((pre) => {
      if (pre.querySelector('.code-copy-btn')) return;

      // Make pre container relative for absolute positioning of copy button
      pre.classList.add('relative', 'group');

      const button = document.createElement('button');
      button.className =
        'code-copy-btn absolute top-3 right-3 flex items-center gap-1.5 rounded-lg bg-slate-800/90 px-2.5 py-1 text-xs font-medium text-slate-300 border border-slate-700/80 hover:bg-slate-700 hover:text-white transition-all shadow-sm backdrop-blur opacity-90 hover:opacity-100';
      button.type = 'button';
      button.setAttribute('aria-label', '코드 복사');
      button.innerHTML = `
        <svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
        </svg>
        <span>복사</span>
      `;

      button.addEventListener('click', async () => {
        const code =
          pre.querySelector('code')?.textContent || pre.textContent || '';
        try {
          await navigator.clipboard.writeText(code);
          const span = button.querySelector('span');
          if (span) span.textContent = '복사됨';
          button.classList.add('text-emerald-400', 'border-emerald-500/50');

          setTimeout(() => {
            if (span) span.textContent = '복사';
            button.classList.remove(
              'text-emerald-400',
              'border-emerald-500/50',
            );
          }, 2000);
        } catch {
          // fallback ignore
        }
      });

      pre.appendChild(button);
    });
  });
</script>
