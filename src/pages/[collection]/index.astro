---
import {
  collectionDescriptions,
  collectionTitles,
  contentCollections,
  isContentCollection,
} from '../../lib/site';
import { getCollection, render } from 'astro:content';
import DocumentLayout from '../../layouts/DocumentLayout.astro';

export async function getStaticPaths() {
  return contentCollections.map((collection) => ({ params: { collection } }));
}

const collection = Astro.params.collection;
if (!isContentCollection(collection)) {
  throw new Error(`Unsupported collection: ${collection}`);
}

const collectionTitle = collectionTitles[collection];
const collectionDescription = collectionDescriptions[collection];

const entries = await getCollection(collection);
const indexEntry = entries.find((item) => item.id === 'index') ?? null;
const entry = indexEntry ?? entries[0] ?? null;
const rendered = entry?.rendered ?? null;
const contentResult = entry && !rendered ? await render(entry) : null;
const Content = contentResult?.Content ?? null;
const metadata = entry?.data ?? {};
---

<DocumentLayout
  title={entry ? (metadata.title ?? collectionTitle) : collectionTitle}
  description={entry
    ? (metadata.description ?? collectionDescription)
    : collectionDescription}
>
  {
    rendered ? (
      <article set:html={rendered.html} class="space-y-6 text-slate-700" />
    ) : Content ? (
      <article class="space-y-6 text-slate-700">
        <Content />
      </article>
    ) : (
      <div class="rounded-3xl border border-dashed border-slate-300 bg-slate-50 p-8 text-slate-700">
        <p class="text-base">
          No content has been added yet for {collectionTitle}. This collection
          route is ready for future documents.
        </p>
      </div>
    )
  }
</DocumentLayout>
