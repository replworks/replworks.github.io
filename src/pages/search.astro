---
import SiteLayout from '../layouts/SiteLayout.astro';
import PagefindConfig from 'astro-pagefind/components/PagefindConfig.astro';
---

<SiteLayout
  title="리플웍스 - REPL Works Search"
  description="Search the REPL Works workflow, prompts, documents, tools, showcase, and FAQ content."
  ogImage="/og/search.png"
>
  <section class="mx-auto max-w-5xl space-y-6 px-4 sm:px-0">
    {/* 검색창 — label + pagefind-input */}
    <div class="-mx-4 sm:mx-0 sm:rounded-2xl border-y sm:border border-slate-200 dark:border-slate-800/80 bg-white/70 dark:bg-slate-900/40 px-4 py-5 sm:px-6">
      <p class="mb-3 text-xs font-mono font-bold uppercase tracking-[0.3em] text-cyan-600 dark:text-cyan-400">
        Search
      </p>
      <pagefind-input
        placeholder="검색어를 입력하세요…"
        class="w-full"
      ></pagefind-input>
    </div>

    {/* 검색 결과 */}
    <div class="-mx-4 sm:mx-0">
      <pagefind-results class="space-y-4"></pagefind-results>
    </div>
  </section>
</SiteLayout>

{/* pagefind-config: 번들 경로 설정 + CSS/JS 로드 */}
<PagefindConfig />
