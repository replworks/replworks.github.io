---
interface Props {
  steps: string[];
}

const { steps } = Astro.props;
---

<div class="flex flex-wrap items-center gap-x-2.5 gap-y-3 py-4 my-4">
  {
    steps.map((step, idx) => (
      <div class="flex items-center gap-x-2.5">
        <span
          class={`inline-block px-3 py-1.5 text-xs font-bold rounded-xl border shadow-sm transition-all ${
            step.endsWith('.md')
              ? 'bg-slate-950 text-cyan-300 border-slate-800 font-mono shadow-cyan-950/20'
              : step.includes('AI')
                ? 'bg-cyan-950/80 text-cyan-200 border-cyan-700/80 font-bold'
                : 'bg-slate-900/90 text-slate-200 border-slate-800'
          }`}
        >
          {step}
        </span>

        {idx < steps.length - 1 && (
          <span class="text-cyan-400 text-xs font-black">→</span>
        )}
      </div>
    ))
  }
</div>
