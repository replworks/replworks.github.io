---
import type { PromptDefinition } from '../data/prompts';

interface Props {
  prompt: PromptDefinition;
  promptText: string;
}

const { prompt, promptText } = Astro.props;
const serializedPrompt = JSON.stringify(promptText)
  .replaceAll('<', '\\u003c')
  .replaceAll('>', '\\u003e')
  .replaceAll('&', '\\u0026');
---

<article class="glass-card rounded-2xl border border-slate-800/80 bg-slate-900/40 p-5 flex flex-col justify-between space-y-5">
  <div class="space-y-4">
    <div class="flex items-start justify-between gap-4">
      <span class="font-mono text-3xl font-black leading-none text-cyan-300">
        {String(prompt.number).padStart(2, '0')}
      </span>
      <span class="rounded-full border border-slate-700 bg-slate-950/60 px-2.5 py-1 text-[10px] font-mono font-bold uppercase tracking-wider text-slate-300">
        {prompt.targetLabel}
      </span>
    </div>

    <div class="space-y-1">
      <h3 class="text-lg font-extrabold tracking-tight text-white">
        {prompt.koreanName}
      </h3>
      <p class="text-sm text-slate-400">{prompt.name}</p>
      <p class="pt-2 text-sm leading-relaxed text-slate-300">
        {prompt.description}
      </p>
    </div>

    <div class="space-y-2">
      <p class="text-[10px] font-bold uppercase tracking-wider text-slate-500">
        {prompt.targetLabel}
      </p>
      <div class="flex flex-wrap gap-2">
        {prompt.targetFiles.map((file) => (
          <code class="rounded border border-slate-700 bg-slate-950/70 px-2 py-1 text-xs font-mono text-slate-300">
            {file}
          </code>
        ))}
      </div>
    </div>
  </div>

  <div class="flex flex-wrap items-center gap-2 border-t border-slate-800/60 pt-4">
    <button
      type="button"
      data-prompt-copy={prompt.slug}
      aria-label={`${prompt.number}번 ${prompt.name} 프롬프트 복사`}
      class="inline-flex items-center justify-center rounded-lg bg-cyan-400 px-3 py-2 text-xs font-bold text-slate-950 transition-colors hover:bg-cyan-300"
    >
      프롬프트 복사
    </button>
    <span
      class="sr-only"
      aria-live="polite"
      data-prompt-copy-status={prompt.slug}
    ></span>
    <a
      href={`/prompts/${prompt.slug}`}
      class="inline-flex items-center justify-center rounded-lg bg-slate-800 px-3 py-2 text-xs font-bold text-slate-200 transition-colors hover:bg-slate-700"
    >
      상세 보기
    </a>
  </div>
</article>

<script
  type="application/json"
  data-prompt-source={prompt.slug}
  set:html={serializedPrompt}
></script>

<script>
  const copyPrompt = async (text: string) => {
    if (navigator.clipboard?.writeText) {
      await navigator.clipboard.writeText(text);
      return;
    }

    const textarea = document.createElement('textarea');
    textarea.value = text;
    textarea.setAttribute('readonly', '');
    textarea.style.position = 'fixed';
    textarea.style.opacity = '0';
    document.body.append(textarea);
    textarea.select();

    try {
      if (!document.execCommand('copy')) {
        throw new Error('Clipboard fallback failed');
      }
    } finally {
      textarea.remove();
    }
  };

  document.addEventListener('click', async (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    const button = target.closest<HTMLButtonElement>(
      'button[data-prompt-copy]',
    );
    if (!button) return;

    const slug = button.dataset.promptCopy;
    if (!slug) return;

    const source = document.querySelector<HTMLScriptElement>(
      `script[data-prompt-source="${slug}"]`,
    );
    const status = document.querySelector<HTMLElement>(
      `[data-prompt-copy-status="${slug}"]`,
    );
    if (!source || !status) return;

    try {
      await copyPrompt(JSON.parse(source.textContent ?? 'null'));
      button.textContent = '복사됨';
      status.textContent = `${button.getAttribute('aria-label')} 완료`;
    } catch {
      button.textContent = '복사 실패';
      status.textContent = `${button.getAttribute('aria-label')} 실패`;
    }

    window.setTimeout(() => {
      button.textContent = '프롬프트 복사';
      status.textContent = '';
    }, 2000);
  });
</script>
