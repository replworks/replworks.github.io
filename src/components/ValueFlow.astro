---
// src/components/ValueFlow.astro
interface Props {
  from: string;
  to: string;
}
const { from, to } = Astro.props;
---

<div
  class="my-6 flex flex-wrap items-center gap-x-3 gap-y-3 rounded-2xl border border-slate-200 bg-slate-50/50 p-5 shadow-sm"
>
  {/* 1. From: Manual Idea */}
  <div class="flex items-center gap-2">
    <span
      class="inline-block px-4 py-2 text-sm font-bold bg-white text-slate-800 border border-slate-200 rounded-lg shadow-sm"
    >
      {from}
    </span>
  </div>

  {/* 2. Transition Arrow with Text */}
  <div class="flex flex-col items-center gap-1 min-w-[50px]">
    <span
      class="text-[10px] font-black uppercase tracking-wider text-blue-600 bg-blue-100/70 px-2 py-0.5 rounded-full animate-pulse"
    >
      Auto
    </span>
    <svg
      class="h-5 w-5 text-blue-500 shrink-0"
      fill="none"
      viewBox="0 0 24 24"
      stroke-width="3"
      stroke="currentColor"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"></path>
    </svg>
  </div>

  {/* 3. To: Actionable Issue */}
  <div class="flex items-center gap-2">
    <span
      class="inline-block px-4 py-2 text-sm font-bold bg-slate-950 text-slate-100 border border-slate-900 rounded-lg shadow-sm"
    >
      {to}
    </span>
  </div>
</div>
