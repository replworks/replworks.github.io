---
interface Props {
  steps: string[];
}

const { steps } = Astro.props;
---

<div class="my-6 rounded-2xl border border-slate-200 bg-slate-100 p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900/60">
  <div class="flex flex-wrap items-center gap-x-2.5 gap-y-3.5">
    {steps.map((step, idx) => (
      <div class="flex items-center gap-2.5">
        <span class="inline-block rounded-xl border border-slate-200 bg-white px-3 py-1.5 text-xs font-bold tracking-tight text-cyan-700 shadow-sm dark:border-slate-800 dark:bg-slate-950 dark:text-cyan-300">
          {step}
        </span>

        {idx < steps.length - 1 && (
          <svg
            class="h-4 w-4 shrink-0 text-cyan-400"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="3"
            stroke="currentColor"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"
            />
          </svg>
        )}
      </div>
    ))}
  </div>
</div>
