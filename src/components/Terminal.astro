---
// src/components/Terminal.astro
interface Props {
  command: string;
}
const { command } = Astro.props;
---

<div
  class="my-5 overflow-hidden rounded-xl border border-slate-800 bg-slate-950 shadow-md max-w-md"
>
  {/* 터미널 상단 바 (맥 스타일 점 3개) */}
  <div
    class="flex items-center justify-between px-4 py-2 bg-slate-900 border-b border-slate-800 select-none"
  >
    <div class="flex gap-1.5">
      <span class="h-2.5 w-2.5 rounded-full bg-rose-500/80"></span>
      <span class="h-2.5 w-2.5 rounded-full bg-amber-500/80"></span>
      <span class="h-2.5 w-2.5 rounded-full bg-emerald-500/80"></span>
    </div>
    <span class="text-[10px] font-mono text-slate-500 tracking-wider font-bold"
      >bash</span
    >
  </div>

  {/* 터미널 본문 내용 */}
  <div
    class="p-4 font-mono text-sm flex items-center justify-between text-slate-100 bg-slate-950"
  >
    <div class="flex items-center gap-2">
      <span class="text-emerald-400 font-bold select-none">$</span>
      <span class="font-semibold tracking-tight">{command}</span>
    </div>
  </div>
</div>
