---
import { navItems } from '../lib/site';
---

<nav
  class="hidden md:flex items-center gap-6 text-sm font-medium text-slate-700"
>
  {
    navItems.map((item) => (
      <a
        class="transition hover:text-slate-900"
        href={item.href}
        rel="nofollow"
      >
        {item.title}
      </a>
    ))
  }
</nav>
