---
import type { PromptDefinition } from '../data/prompts';

interface Props {
  prompt: PromptDefinition;
}

const { prompt } = Astro.props;
---

<div class="glass-card mb-8 space-y-4 rounded-2xl border border-slate-800/80 bg-slate-900/60 p-6 md:p-8">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div class="space-y-1">
      <div class="flex items-center gap-3">
        <span class="font-mono text-3xl font-black text-cyan-300">
          {String(prompt.number).padStart(2, '0')}
        </span>
        <span class="rounded-full border border-cyan-500/30 bg-cyan-950/50 px-3 py-1 text-xs font-semibold text-cyan-300">
          {prompt.group}
        </span>
      </div>
      <h1 class="text-2xl font-black tracking-tight text-white md:text-3xl pt-2">
        {prompt.koreanName}
      </h1>
      <p class="text-base font-medium text-slate-400">{prompt.name}</p>
    </div>

    <div class="flex flex-col items-start md:items-end gap-2">
      <span class="text-xs font-bold uppercase tracking-wider text-slate-400">
        {prompt.targetLabel}
      </span>
      <div class="flex flex-wrap gap-2">
        {prompt.targetFiles.map((file) => (
          <code class="rounded border border-slate-700 bg-slate-950/80 px-2.5 py-1 text-xs font-mono text-cyan-300">
            {file}
          </code>
        ))}
      </div>
    </div>
  </div>

  <p class="text-base leading-relaxed text-slate-300 border-t border-slate-800/80 pt-4">
    {prompt.description}
  </p>
</div>
