---
// src/components/OperationLoop.astro
interface Props {
  steps: string[];
}
const { steps } = Astro.props;
---

<div class="my-6 rounded-2xl border border-cyan-500/30 bg-gradient-to-r from-cyan-950/30 to-indigo-950/30 p-5 shadow-sm">
  <div class="flex flex-wrap items-center gap-x-3 gap-y-3.5">
    {steps.map((step, idx) => (
      <div class="flex items-center gap-3">
        <span
          class={`inline-block px-3.5 py-1.5 text-xs font-bold rounded-xl border shadow-sm transition-all ${
            step.includes('Update')
              ? 'bg-white dark:bg-slate-950 text-cyan-700 dark:text-cyan-300 border-slate-200 dark:border-slate-800 font-mono'
              : 'bg-slate-100 dark:bg-slate-900/90 text-slate-800 dark:text-slate-200 border-slate-200 dark:border-slate-800'
          }`}
        >
          {step}
        </span>

        {idx < steps.length - 1 ? (
          <svg
            class="h-4 w-4 text-cyan-400 shrink-0"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="3"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"
            />
          </svg>
        ) : (
          <div class="flex items-center gap-1.5 px-2.5 py-1 bg-cyan-100 dark:bg-cyan-950/80 text-cyan-700 dark:text-cyan-300 border border-cyan-300 dark:border-cyan-800/80 text-xs font-mono font-black rounded-lg uppercase tracking-wider animate-pulse">
            <svg
              class="h-3.5 w-3.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="3"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99"
              />
            </svg>
            Loop
          </div>
        )}
      </div>
    ))}
  </div>
</div>
