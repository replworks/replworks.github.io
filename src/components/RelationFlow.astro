---
// src/components/RelationFlow.astro
interface Props {
  items: string[];
}
const { items } = Astro.props;
---

<div class="my-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-slate-100 dark:bg-slate-900/60 p-6 shadow-sm">
  <div class="flex flex-wrap items-center gap-x-3 gap-y-4">
    {items.map((item, idx) => (
      <div class="flex items-center gap-3">
        <div class="flex items-center gap-2 px-3.5 py-2 rounded-xl bg-white dark:bg-slate-950 border border-slate-200 dark:border-slate-800 shadow-sm hover:border-slate-400 dark:hover:border-slate-700 transition-all">
          <span class="flex h-5 w-5 items-center justify-center rounded-lg bg-cyan-100 dark:bg-cyan-950 text-[10px] font-mono font-black text-cyan-700 dark:text-cyan-400 border border-cyan-300 dark:border-cyan-800/80">
            0{idx + 1}
          </span>
          <span class="text-xs font-extrabold text-slate-900 dark:text-white tracking-tight">
            {item}
          </span>
        </div>

        {idx < items.length - 1 && (
          <svg
            class="h-4 w-4 text-cyan-400 shrink-0"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="3"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"
            />
          </svg>
        )}
      </div>
    ))}
  </div>
</div>
