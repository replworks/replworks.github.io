---
import type { ContentCollection } from '../lib/site';
import { collectionTitles } from '../lib/site';
import { promptDefinitions } from '../data/prompts';
import { showcaseProjects } from '../data/showcase';
import { getCollection } from 'astro:content';

interface Props {
  collection: ContentCollection;
  currentSlug: string;
}

const { collection, currentSlug } = Astro.props;

interface SidebarItem {
  slug: string;
  title: string;
  subtitle?: string;
  badge?: string;
  href: string;
}

let items: SidebarItem[] = [];

if (collection === 'prompts') {
  items = promptDefinitions.map((p) => ({
    slug: p.slug,
    title: `${String(p.number).padStart(2, '0')}. ${p.koreanName}`,
    subtitle: p.name,
    href: `/prompts/${p.slug}`,
  }));
} else if (collection === 'showcase') {
  items = showcaseProjects
    .slice()
    .sort((a, b) => a.order - b.order)
    .map((p) => ({
      slug: p.slug,
      title: p.name,
      badge: p.tags[0],
      href: `/showcase/${p.slug}`,
    }));
} else {
  const entries = await getCollection(collection);
  items = entries
    .filter((e) => e.id !== 'index')
    .map((e) => ({
      slug: e.id,
      title: e.data.title ?? e.id,
      href: `/${collection}/${e.id}`,
    }));
}

const collectionTitle = collectionTitles[collection];
---

<aside class="w-full space-y-4">
  <div class="glass-card rounded-none sm:rounded-2xl border-y sm:border border-slate-200 dark:border-slate-800/80 bg-white/70 dark:bg-slate-900/50 p-5 sm:shadow-xl">
    <div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-800 pb-3 mb-4">
      <h3 class="text-xs font-mono font-bold tracking-wider text-slate-400 uppercase">
        {collectionTitle} 목록
      </h3>
      <span class="rounded-full bg-cyan-100 dark:bg-cyan-950/60 px-2 py-0.5 text-[10px] font-mono text-cyan-700 dark:text-cyan-400 font-bold border border-cyan-500/20">
        {items.length}
      </span>
    </div>

    <nav aria-label={`${collectionTitle} 상세 목록`} class="not-prose">
      <ul class="list-none space-y-1 p-0 m-0">
        {items.map((item) => {
          const isActive = item.slug === currentSlug;
          return (
            <li>
              <a
                href={item.href}
                class={`flex items-center justify-between rounded-xl px-3 py-2 text-xs transition-all ${
                  isActive
                    ? 'bg-cyan-50 dark:bg-cyan-500/10 border border-cyan-500/30 text-cyan-700 dark:text-cyan-300 font-bold shadow-sm'
                    : 'text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800/60 hover:text-slate-950 dark:hover:text-white border border-transparent'
                }`}
              >
                <div class="flex flex-col gap-0.5 truncate">
                  <span class="truncate">{item.title}</span>
                  {item.subtitle && (
                    <span class="text-[10px] font-normal text-slate-500 dark:text-slate-500 truncate">
                      {item.subtitle}
                    </span>
                  )}
                </div>
                {isActive && (
                  <span class="h-2 w-2 rounded-full bg-cyan-400 shrink-0 ml-2 animate-pulse"></span>
                )}
                {!isActive && item.badge && (
                  <span class="rounded border border-slate-300 dark:border-slate-700 bg-slate-100 dark:bg-slate-950/60 px-1.5 py-0.5 text-[9px] font-mono text-slate-600 dark:text-slate-400 shrink-0 ml-2">
                    {item.badge}
                  </span>
                )}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  </div>
</aside>
