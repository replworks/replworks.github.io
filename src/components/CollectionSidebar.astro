---
import type { ContentCollection } from '../lib/site';
import { collectionTitles } from '../lib/site';
import { promptDefinitions } from '../data/prompts';
import { documentMenu } from '../data/documents';
import { showcaseProjects } from '../data/showcase';
import { getCollection } from 'astro:content';

interface Props {
  collection: ContentCollection;
  currentSlug: string;
  overrideItems?: SidebarItem[];
}

const { collection, currentSlug, overrideItems } = Astro.props;

interface SidebarItem {
  slug: string;
  title: string;
  subtitle?: string;
  badge?: string;
  href: string;
}

let items: SidebarItem[] = [];

if (overrideItems) {
  // 외부에서 직접 항목 주입 (FAQ TOC 등)
  items = overrideItems;
} else if (collection === 'prompts') {
  items = promptDefinitions.map((p) => ({
    slug: p.slug,
    title: `${String(p.number).padStart(2, '0')}. ${p.koreanName}`,
    subtitle: p.name,
    href: `/prompts/${p.slug}/`,
  }));
} else if (collection === 'documents') {
  const entries = await getCollection(collection);
  const entriesBySlug = new Map(entries.map((entry) => [entry.id, entry]));
  items = documentMenu.map(({ slug, title, subtitle, badge }) => {
    const entry = entriesBySlug.get(slug);
    if (!entry) {
      throw new Error(`Missing document content for sidebar entry "${slug}"`);
    }

    return {
      slug,
      title: title ?? entry.data.title ?? slug,
      subtitle,
      badge,
      href: `/documents/${slug}/`,
    };
  });
} else if (collection === 'showcase') {
  items = showcaseProjects
    .slice()
    .sort((a, b) => a.order - b.order)
    .map((p) => ({
      slug: p.slug,
      title: p.name,
      badge: p.tags[0],
      href: `/showcase/${p.slug}/`,
    }));
} else {
  const entries = await getCollection(collection);
  items = entries
    .filter((e) => e.id !== 'index')
    .map((e) => ({
      slug: e.id,
      title: e.data.title ?? e.id,
      href: `/${collection}/${e.id}/`,
    }));
}

const collectionTitle = collectionTitles[collection];

// 컬렉션 인덱스 페이지를 첫 번째 항목으로 추가 (overrideItems가 없을 때만)
const indexItem: SidebarItem = {
  slug: '_index',
  title: collectionTitle,
  href: `/${collection}/`,
};

const allItems = overrideItems ? items : [indexItem, ...items];

// TOC 모드(overrideItems 제공)일 때는 첫 번째 항목이 기본 active
const serverActiveSlug = overrideItems ? (items[0]?.slug ?? null) : currentSlug;
---

<aside class="w-full">
  {/* ── 모바일: <details> 접기 메뉴 (lg 미만) ── */}
  <div class="lg:hidden">
    <details class="group">
      <summary class="flex cursor-pointer select-none list-none items-center gap-2 rounded-xl border border-slate-200 dark:border-slate-800 bg-white/80 dark:bg-slate-900/60 px-4 py-2.5 text-xs font-bold text-slate-700 dark:text-slate-200 shadow-sm transition hover:border-slate-300 dark:hover:border-slate-700 [&::-webkit-details-marker]:hidden">
        <svg
          class="h-4 w-4 text-slate-500 dark:text-slate-400 shrink-0"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M4 6h16M4 12h16M4 18h16"
          />
        </svg>
        <span>{collectionTitle} 목록</span>
        <span class="ml-auto rounded-full bg-cyan-100 dark:bg-cyan-950/60 px-2 py-0.5 text-[10px] font-mono text-cyan-700 dark:text-cyan-400 border border-cyan-500/20">
          {items.length}
        </span>
        <svg
          class="h-3.5 w-3.5 text-slate-400 shrink-0 transition-transform group-open:rotate-180"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2.5"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M19 9l-7 7-7-7"
          />
        </svg>
      </summary>

      <nav
        aria-label={`${collectionTitle} 목록`}
        class="not-prose mt-2 -mx-4 sm:mx-0 rounded-none sm:rounded-2xl border-y sm:border border-slate-200 dark:border-slate-800/80 bg-white/70 dark:bg-slate-900/50 p-3 shadow-sm"
      >
        <ul class="list-none space-y-0.5 p-0 m-0">
          {allItems.map((item) => {
            const isActive = item.slug === serverActiveSlug;
            return (
              <li>
                <a
                  href={item.href}
                  data-sidebar-link
                  data-slug={item.slug}
                  class={`flex items-center justify-between rounded-xl px-3 py-2 text-xs transition-all ${
                    isActive
                      ? 'bg-cyan-50 dark:bg-cyan-500/10 border border-cyan-500/30 text-cyan-700 dark:text-cyan-300 font-bold shadow-sm'
                      : 'text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800/60 hover:text-slate-950 dark:hover:text-white border border-transparent'
                  }`}
                >
                  <div class="flex flex-col gap-0.5 truncate">
                    <span class="truncate">{item.title}</span>
                    {item.subtitle && (
                      <span class="text-[10px] font-normal text-slate-500 dark:text-slate-500 truncate">
                        {item.subtitle}
                      </span>
                    )}
                  </div>
                  <span
                    data-active-dot
                    class={`h-2 w-2 rounded-full bg-cyan-400 shrink-0 ml-2 animate-pulse ${isActive ? '' : 'hidden'}`}
                  ></span>
                  {item.badge && (
                    <span
                      class={`rounded border border-slate-300 dark:border-slate-700 bg-slate-100 dark:bg-slate-950/60 px-1.5 py-0.5 text-[9px] font-mono text-slate-600 dark:text-slate-400 shrink-0 ml-2 ${isActive ? 'hidden' : ''}`}
                    >
                      {item.badge}
                    </span>
                  )}
                </a>
              </li>
            );
          })}
        </ul>
      </nav>
    </details>
  </div>

  {/* ── 데스크톱: 항상 표시 사이드바 (lg 이상) ── */}
  <div class="hidden lg:block glass-card rounded-2xl border border-slate-200 dark:border-slate-800/80 bg-white/70 dark:bg-slate-900/50 p-4 shadow-xl">
    <div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-800 pb-3 mb-3">
      <h3 class="text-xs font-mono font-bold tracking-wider text-slate-400 uppercase">
        {collectionTitle} 목록
      </h3>
      <span class="rounded-full bg-cyan-100 dark:bg-cyan-950/60 px-2 py-0.5 text-[10px] font-mono text-cyan-700 dark:text-cyan-400 font-bold border border-cyan-500/20">
        {items.length}
      </span>
    </div>

    <nav aria-label={`${collectionTitle} 목록`} class="not-prose">
      <ul class="list-none space-y-0.5 p-0 m-0">
        {allItems.map((item) => {
          const isActive = item.slug === serverActiveSlug;
          return (
            <li>
              <a
                href={item.href}
                data-sidebar-link
                data-slug={item.slug}
                class={`flex items-center justify-between rounded-xl px-3 py-2 text-xs transition-all ${
                  isActive
                    ? 'bg-cyan-50 dark:bg-cyan-500/10 border border-cyan-500/30 text-cyan-700 dark:text-cyan-300 font-bold shadow-sm'
                    : 'text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800/60 hover:text-slate-950 dark:hover:text-white border border-transparent'
                }`}
              >
                <div class="flex flex-col gap-0.5 truncate">
                  <span class="truncate">{item.title}</span>
                  {item.subtitle && (
                    <span class="text-[10px] font-normal text-slate-500 dark:text-slate-500 truncate">
                      {item.subtitle}
                    </span>
                  )}
                </div>
                <span
                  data-active-dot
                  class={`h-2 w-2 rounded-full bg-cyan-400 shrink-0 ml-2 animate-pulse ${isActive ? '' : 'hidden'}`}
                ></span>
                {item.badge && (
                  <span
                    class={`rounded border border-slate-300 dark:border-slate-700 bg-slate-100 dark:bg-slate-950/60 px-1.5 py-0.5 text-[9px] font-mono text-slate-600 dark:text-slate-400 shrink-0 ml-2 ${isActive ? 'hidden' : ''}`}
                  >
                    {item.badge}
                  </span>
                )}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  </div>
</aside>

<script>
  function setupSidebar() {
    const aside = document.querySelector('aside');
    if (!aside) return;

    const links = Array.from(
      aside.querySelectorAll<HTMLAnchorElement>('a[data-sidebar-link]'),
    );
    const anchorLinks = links.filter((link) => {
      const href = link.getAttribute('href');
      return href && href.startsWith('#');
    });

    if (anchorLinks.length === 0) return;

    const activeClasses = [
      'bg-cyan-50',
      'dark:bg-cyan-500/10',
      'border-cyan-500/30',
      'text-cyan-700',
      'dark:text-cyan-300',
      'font-bold',
      'shadow-sm',
    ];
    const inactiveClasses = [
      'text-slate-700',
      'dark:text-slate-300',
      'border-transparent',
    ];

    function setActive(slug: string) {
      links.forEach((link) => {
        const linkSlug = link.getAttribute('data-slug');
        const dot = link.querySelector('[data-active-dot]');
        const badge = link.querySelector(
          'span[class*="font-mono"]:not([data-active-dot])',
        );
        const isTarget = linkSlug === slug;

        if (isTarget) {
          link.classList.remove(...inactiveClasses);
          link.classList.add(...activeClasses);
          dot?.classList.remove('hidden');
          badge?.classList.add('hidden');
        } else {
          link.classList.remove(...activeClasses);
          link.classList.add(...inactiveClasses);
          dot?.classList.add('hidden');
          badge?.classList.remove('hidden');
        }
      });
    }

    // Handle clicks on anchor links
    anchorLinks.forEach((link) => {
      link.addEventListener('click', () => {
        const slug = link.getAttribute('data-slug');
        if (slug) {
          setActive(slug);
        }
        // If inside a mobile details dropdown, close it
        const details = link.closest('details');
        if (details && details.hasAttribute('open')) {
          details.removeAttribute('open');
        }
      });
    });

    // Scroll spy for headings
    const slugs = Array.from(
      new Set(
        anchorLinks.map((l) => l.getAttribute('data-slug')).filter(Boolean),
      ),
    ) as string[];
    const headings = slugs
      .map((slug) => document.getElementById(slug))
      .filter((el): el is HTMLElement => el !== null);

    if (headings.length > 0) {
      let isClickScrolling = false;

      anchorLinks.forEach((link) => {
        link.addEventListener('click', () => {
          isClickScrolling = true;
          setTimeout(() => {
            isClickScrolling = false;
          }, 800);
        });
      });

      const onScroll = () => {
        if (isClickScrolling) return;

        // Header offset + padding
        const scrollPosition = window.scrollY + 140;
        let currentId = headings[0].id;

        for (const heading of headings) {
          if (heading.offsetTop <= scrollPosition) {
            currentId = heading.id;
          } else {
            break;
          }
        }

        if (currentId) {
          setActive(currentId);
        }
      };

      window.addEventListener('scroll', onScroll, { passive: true });

      // Initial check based on current hash or scroll position
      if (window.location.hash) {
        const hashSlug = decodeURIComponent(window.location.hash.slice(1));
        if (slugs.includes(hashSlug)) {
          setActive(hashSlug);
        }
      } else {
        onScroll();
      }
    }
  }

  // Initial setup
  setupSidebar();

  // Support Astro view transitions / page loads
  document.addEventListener('astro:page-load', setupSidebar);
</script>
