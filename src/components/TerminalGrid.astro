---
// src/components/TerminalGrid.astro
interface Props {
  commands: string[];
}
const { commands } = Astro.props;
---

<div
  class="my-5 flex flex-wrap gap-2.5 rounded-2xl border border-slate-800 bg-slate-950 p-4 shadow-md"
>
  {
    commands.map((cmd) => (
      <div class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-slate-900 border border-slate-800 text-sm font-mono text-slate-100 shadow-sm hover:border-slate-700 transition-all">
        {/* 프롬프트 기호 */}
        <span class="text-emerald-400 font-bold select-none">$</span>
        <span class="font-semibold tracking-tight">{cmd}</span>
      </div>
    ))
  }
</div>
