<section class="relative w-full min-h-[85vh] flex items-center overflow-hidden bg-[#090d16] bg-grid-pattern bg-radial-gradient border-b border-slate-800/80 py-16 lg:py-24">
  {/* Ambient Background Glows */}
  <div class="absolute -top-40 right-0 h-96 w-96 rounded-full bg-cyan-500/15 blur-[120px] pointer-events-none animate-orb-1"></div>
  <div class="absolute bottom-0 left-10 h-80 w-80 rounded-full bg-indigo-500/15 blur-[100px] pointer-events-none animate-orb-2"></div>
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 h-[500px] w-[500px] rounded-full bg-emerald-500/5 blur-[140px] pointer-events-none"></div>

  <div class="relative z-10 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      {/* Left Column: Core Value Pitch */}
      <div class="lg:col-span-6 space-y-6 text-left">
        {/* Top Tagline */}
        <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-slate-900/90 border border-slate-800 text-[11px] font-mono font-bold tracking-wide text-cyan-400 select-none shadow-inner hover:border-cyan-500/50 transition-colors">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-cyan-400"></span>
          </span>
          AI-NATIVE PRODUCT DEVELOPMENT FRAMEWORK
        </span>

        {/* Main Headline */}
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-white tracking-tight leading-[1.12]">
          AI로 만든 프로젝트가
          <br />
          <span class="text-gradient-cyan">산으로 가지 않게</span>
        </h1>

        {/* Core Subcopy */}
        <p class="text-base sm:text-lg text-slate-300 leading-relaxed font-normal max-w-2xl">
          대화형 AI로 기획하고 코딩형 AI로 개발하는 방식은 이미 맞습니다. REPL
          Works는 완료 후 수정과 개선까지 프로젝트가 흐트러지지 않게 하는 문서
          방법론입니다.
        </p>

        {/* Action CTA Buttons */}
        <div class="pt-4 flex flex-wrap items-center gap-4">
          <a
            href="/workflow"
            class="inline-flex items-center justify-center px-6 py-3.5 text-xs font-extrabold text-slate-950 bg-gradient-to-r from-cyan-400 to-emerald-400 rounded-xl shadow-lg shadow-cyan-500/20 hover:shadow-cyan-500/35 hover:scale-[1.02] active:scale-[0.98] transition-all group shrink-0"
          >
            <span>워크플로 시작하기</span>
            <svg
              class="h-4 w-4 ml-2 transition-transform group-hover:translate-x-1"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="3"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"
              ></path>
            </svg>
          </a>
          <a
            href="/showcase"
            class="inline-flex items-center justify-center px-6 py-3.5 text-xs font-extrabold text-slate-200 bg-slate-900/90 border border-slate-800 rounded-xl hover:bg-slate-800 hover:text-white hover:border-slate-700 hover:shadow-lg hover:shadow-indigo-500/10 transition-all shrink-0"
          >
            실제 결과물 보기
          </a>
        </div>
      </div>

      {/* Right Column: Animated Triangle Diagram */}
      <div class="lg:col-span-6 w-full flex justify-center">
        <div class="glass-card rounded-3xl border border-slate-800/90 bg-[#0c1322]/85 p-6 sm:p-8 shadow-2xl relative w-full max-w-lg overflow-hidden group hover:border-cyan-500/40 transition-colors">
          {/* Subtle Cyber Corner Accents */}
          <div class="absolute top-0 right-0 w-24 h-24 bg-cyan-500/10 rounded-full blur-2xl group-hover:bg-cyan-500/20 transition-all pointer-events-none"></div>
          <div class="absolute bottom-0 left-0 w-24 h-24 bg-emerald-500/10 rounded-full blur-2xl group-hover:bg-emerald-500/20 transition-all pointer-events-none"></div>

          <svg
            viewBox="0 0 500 420"
            class="w-full h-auto max-w-full overflow-visible"
            role="img"
            aria-label="Human, 대화형 AI, 코딩형 AI의 협업 관계와 문서·Git 자산을 나타내는 애니메이션 다이어그램"
          >
            <title>Human, 대화형 AI, 코딩형 AI 협업 다이어그램</title>
            <desc>
              Human이 상단에서 결정하고 검토·커밋하며, 대화형 AI와 함께 기획 및
              문서를 작성하고, 코딩형 AI가 문서와 코드를 함께 수정하는
              다이어그램. 하단에는 문서·Git 자산이 위치합니다.
            </desc>

            <defs>
              {/* Arrow Markers */}
              <marker
                id="arrow-cyan"
                viewBox="0 0 10 10"
                refX="5"
                refY="5"
                markerWidth="6"
                markerHeight="6"
                orient="auto-start-reverse"
              >
                <path d="M 0 1 L 10 5 L 0 9 z" fill="#38bdf8" />
              </marker>
              <marker
                id="arrow-emerald"
                viewBox="0 0 10 10"
                refX="5"
                refY="5"
                markerWidth="6"
                markerHeight="6"
                orient="auto-start-reverse"
              >
                <path d="M 0 1 L 10 5 L 0 9 z" fill="#34d399" />
              </marker>

              {/* Line Gradients */}
              <linearGradient
                id="line-human-discussion"
                x1="0%"
                y1="0%"
                x2="0%"
                y2="100%"
              >
                <stop offset="0%" stop-color="#818cf8" />
                <stop offset="100%" stop-color="#38bdf8" />
              </linearGradient>
              <linearGradient
                id="line-human-execution"
                x1="0%"
                y1="0%"
                x2="0%"
                y2="100%"
              >
                <stop offset="0%" stop-color="#818cf8" />
                <stop offset="100%" stop-color="#34d399" />
              </linearGradient>

              {/* Glow Filters for Nodes */}
              <filter id="glow-indigo" x="-30%" y="-30%" width="160%" height="160%">
                <feGaussianBlur stdDeviation="4" result="blur" />
                <feMerge>
                  <feMergeNode in="blur" />
                  <feMergeNode in="SourceGraphic" />
                </feMerge>
              </filter>
              <filter id="glow-cyan" x="-30%" y="-30%" width="160%" height="160%">
                <feGaussianBlur stdDeviation="4" result="blur" />
                <feMerge>
                  <feMergeNode in="blur" />
                  <feMergeNode in="SourceGraphic" />
                </feMerge>
              </filter>
              <filter id="glow-emerald" x="-30%" y="-30%" width="160%" height="160%">
                <feGaussianBlur stdDeviation="4" result="blur" />
                <feMerge>
                  <feMergeNode in="blur" />
                  <feMergeNode in="SourceGraphic" />
                </feMerge>
              </filter>
            </defs>

            {/* Path 1: Human <-> 대화형 AI */}
            <line
              x1="220"
              y1="95"
              x2="135"
              y2="245"
              stroke="url(#line-human-discussion)"
              stroke-width="2.5"
              stroke-dasharray="6 4"
              class="animate-dash-discussion"
              marker-start="url(#arrow-cyan)"
              marker-end="url(#arrow-cyan)"
            />

            {/* Path 2: Human <-> 코딩형 AI */}
            <line
              x1="280"
              y1="95"
              x2="365"
              y2="245"
              stroke="url(#line-human-execution)"
              stroke-width="2.5"
              stroke-dasharray="6 4"
              class="animate-dash-execution"
              marker-start="url(#arrow-emerald)"
              marker-end="url(#arrow-emerald)"
            />

            {/* Animated Traveling Data Pulses */}
            {/* Line 1 Data Flow (Human -> Discussion AI & back) */}
            <circle r="4.5" fill="#38bdf8" filter="url(#glow-cyan)">
              <animateMotion dur="2.4s" repeatCount="indefinite" path="M 220 95 L 135 245" />
            </circle>
            <circle r="3.5" fill="#818cf8" filter="url(#glow-indigo)">
              <animateMotion dur="2.4s" begin="1.2s" repeatCount="indefinite" path="M 135 245 L 220 95" />
            </circle>

            {/* Line 2 Data Flow (Human -> Execution AI & back) */}
            <circle r="4.5" fill="#34d399" filter="url(#glow-emerald)">
              <animateMotion dur="2.6s" repeatCount="indefinite" path="M 280 95 L 365 245" />
            </circle>
            <circle r="3.5" fill="#818cf8" filter="url(#glow-indigo)">
              <animateMotion dur="2.6s" begin="1.3s" repeatCount="indefinite" path="M 365 245 L 280 95" />
            </circle>

            {/* Node 1 (Top): Human */}
            <g transform="translate(170, 30)">
              <animateTransform
                attributeName="transform"
                type="translate"
                values="170 30; 170 24; 170 30"
                dur="4s"
                repeatCount="indefinite"
              />
              <rect
                x="0"
                y="0"
                width="160"
                height="64"
                rx="16"
                fill="#1e1b4b"
                fill-opacity="0.9"
                stroke="#6366f1"
                stroke-width="2"
                filter="url(#glow-indigo)"
              />
              <text
                x="80"
                y="28"
                text-anchor="middle"
                fill="#ffffff"
                font-weight="900"
                font-size="16"
              >
                Human
              </text>
              <text
                x="80"
                y="48"
                text-anchor="middle"
                fill="#a5b4fc"
                font-weight="700"
                font-size="12"
              >
                결정하고 검토·커밋
              </text>
            </g>

            {/* Node 2 (Bottom Left): ① 대화형 AI */}
            <g transform="translate(15, 235)">
              <animateTransform
                attributeName="transform"
                type="translate"
                values="15 235; 15 241; 15 235"
                dur="4.8s"
                repeatCount="indefinite"
              />
              <rect
                x="0"
                y="0"
                width="200"
                height="84"
                rx="16"
                fill="#082f49"
                fill-opacity="0.9"
                stroke="#38bdf8"
                stroke-width="2"
                filter="url(#glow-cyan)"
              />
              <text
                x="100"
                y="28"
                text-anchor="middle"
                fill="#ffffff"
                font-weight="900"
                font-size="15"
              >
                ① 대화형 AI
              </text>
              <text
                x="100"
                y="46"
                text-anchor="middle"
                fill="#7dd3fc"
                font-weight="600"
                font-size="11"
              >
                (ChatGPT · Claude)
              </text>
              <text
                x="100"
                y="66"
                text-anchor="middle"
                fill="#bae6fd"
                font-weight="700"
                font-size="11.5"
              >
                함께 기획하고 문서 작성
              </text>
            </g>

            {/* Node 3 (Bottom Right): ② 코딩형 AI */}
            <g transform="translate(285, 235)">
              <animateTransform
                attributeName="transform"
                type="translate"
                values="285 235; 285 229; 285 235"
                dur="4.4s"
                repeatCount="indefinite"
              />
              <rect
                x="0"
                y="0"
                width="200"
                height="84"
                rx="16"
                fill="#064e3b"
                fill-opacity="0.9"
                stroke="#34d399"
                stroke-width="2"
                filter="url(#glow-emerald)"
              />
              <text
                x="100"
                y="28"
                text-anchor="middle"
                fill="#ffffff"
                font-weight="900"
                font-size="15"
              >
                ② 코딩형 AI
              </text>
              <text
                x="100"
                y="46"
                text-anchor="middle"
                fill="#6ee7b7"
                font-weight="600"
                font-size="11"
              >
                (Codex · Claude Code)
              </text>
              <text
                x="100"
                y="66"
                text-anchor="middle"
                fill="#a7f3d0"
                font-weight="700"
                font-size="11.5"
              >
                문서와 코드를 함께 수정
              </text>
            </g>

            {/* Bottom Edge Label: 문서 · Git (Text only, no line) */}
            <g transform="translate(250, 375)">
              <rect
                x="-70"
                y="-18"
                width="140"
                height="32"
                rx="12"
                fill="#0f172a"
                fill-opacity="0.9"
                stroke="#475569"
                stroke-width="1.5"
              />
              <text
                x="0"
                y="3"
                text-anchor="middle"
                fill="#cbd5e1"
                font-weight="800"
                font-size="13"
                letter-spacing="1"
              >
                문서 · Git
              </text>
            </g>
          </svg>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Dash Flow Animation for Connection Lines */
  @keyframes dash-flow {
    from {
      stroke-dashoffset: 20;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  /* Ambient Glow Drift Keyframes */
  @keyframes orb-drift-1 {
    0%, 100% {
      transform: translate(0, 0) scale(1);
    }
    50% {
      transform: translate(-25px, 20px) scale(1.08);
    }
  }

  @keyframes orb-drift-2 {
    0%, 100% {
      transform: translate(0, 0) scale(1);
    }
    50% {
      transform: translate(25px, -20px) scale(1.12);
    }
  }

  .animate-dash-discussion {
    animation: dash-flow 1.4s linear infinite;
  }

  .animate-dash-execution {
    animation: dash-flow 1.4s linear infinite reverse;
  }

  .animate-orb-1 {
    animation: orb-drift-1 9s ease-in-out infinite;
  }

  .animate-orb-2 {
    animation: orb-drift-2 11s ease-in-out infinite;
  }
</style>


