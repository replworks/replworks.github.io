---
---

<section class="relative w-full overflow-hidden bg-slate-50 dark:bg-[#070a12] border-b border-slate-200 dark:border-slate-800/80 py-8 sm:py-10 lg:py-12 transition-colors duration-200">
  {/* Layer 1: Static Cyber Grid Pattern across the ENTIRE Hero Backdrop (0 CPU overhead) */}
  <div class="absolute inset-0 bg-grid-pattern opacity-70 pointer-events-none"></div>

  {/* Layer 2: Static Radial Gradient Spotlight (0 CPU overhead) */}
  <div class="absolute inset-0 bg-radial-gradient opacity-90 pointer-events-none"></div>

  {/* Layer 3: Ultra-light GPU-accelerated Soft Gradient Orbs (No CSS Blur Filter, 100% GPU composited) */}
  <div class="absolute -top-10 -right-10 w-[550px] h-[550px] rounded-full bg-radial-cyan opacity-60 pointer-events-none animate-gpu-float-1"></div>
  <div class="absolute -bottom-10 -left-10 w-[600px] h-[600px] rounded-full bg-radial-indigo opacity-60 pointer-events-none animate-gpu-float-2"></div>

  <div class="relative z-10 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      {/* Left Column: Core Value Pitch */}
      <div class="lg:col-span-6 space-y-5 text-left">
        {/* Top Tagline */}
        <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/90 dark:bg-slate-900/90 border border-slate-200 dark:border-slate-800 text-[11px] font-mono font-bold tracking-wide text-cyan-700 dark:text-cyan-400 select-none shadow-inner hover:border-cyan-500/50 transition-colors">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-cyan-400"></span>
          </span>
          AI-NATIVE PRODUCT DEVELOPMENT FRAMEWORK
        </span>

        {/* Main Headline */}
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-slate-900 dark:text-white tracking-tight leading-[1.12]">
          AI로 만든 프로젝트가
          <br />
          <span class="text-gradient-cyan">산으로 가지 않게</span>
        </h1>

        {/* Core Subcopy */}
        <p class="text-base sm:text-lg text-slate-700 dark:text-slate-300 leading-relaxed font-normal max-w-2xl">
          대화형 AI로 기획하고 코딩형 AI로 개발하는 방식은 이미 맞습니다. REPL
          Works는 완료 후 수정과 개선까지 프로젝트가 흐트러지지 않게 하는 문서
          방법론입니다.
        </p>

        {/* Action CTA Buttons */}
        <div class="pt-4 flex flex-wrap items-center gap-4">
          <a
            href="/workflow"
            class="inline-flex items-center justify-center px-6 py-3.5 text-xs font-extrabold text-slate-950 bg-gradient-to-r from-cyan-400 to-emerald-400 rounded-xl shadow-lg shadow-cyan-500/20 hover:shadow-cyan-500/35 hover:scale-[1.02] active:scale-[0.98] transition-all group shrink-0"
          >
            <span>워크플로 시작하기</span>
            <svg
              class="h-4 w-4 ml-2 transition-transform group-hover:translate-x-1"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="3"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"
              ></path>
            </svg>
          </a>
          <a
            href="/showcase"
            class="inline-flex items-center justify-center px-6 py-3.5 text-xs font-extrabold text-slate-800 dark:text-slate-200 bg-white/90 dark:bg-slate-900/90 border border-slate-300 dark:border-slate-800 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-slate-950 dark:hover:text-white hover:border-slate-400 dark:hover:border-slate-700 hover:shadow-lg hover:shadow-indigo-500/10 transition-all shrink-0"
          >
            실제 결과물 보기
          </a>
        </div>
      </div>

      {/* Right Column: Lightweight Animated Triangle Diagram */}
      <div class="lg:col-span-6 w-full flex justify-center">
        <div class="hero-diagram glass-card rounded-3xl border border-slate-200 dark:border-slate-800/90 p-3.5 sm:p-6 shadow-2xl relative w-full max-w-lg overflow-hidden group hover:border-cyan-500/40 transition-colors">
          <svg
            viewBox="0 0 500 445"
            class="w-full h-auto max-w-full overflow-visible"
            role="img"
            aria-label="Human, 대화형 AI, 코딩형 AI의 협업 관계와 문서·Git 자산을 나타내는 다이어그램"
          >
            <title>Human, 대화형 AI, 코딩형 AI 협업 다이어그램</title>
            <desc>
              Human이 상단에서 결정하고 검토·커밋하며, 대화형 AI와 함께 기획 및
              문서를 작성하고, 코딩형 AI가 문서와 코드를 함께 수정하는
              다이어그램. 하단에는 문서·Git 자산이 위치합니다.
            </desc>

            <defs>
              {/* Arrow Markers */}
              <marker
                id="arrow-cyan"
                viewBox="0 0 10 10"
                refX="5"
                refY="5"
                markerWidth="6"
                markerHeight="6"
                orient="auto-start-reverse"
              >
                <path d="M 0 1 L 10 5 L 0 9 z" fill="#38bdf8" />
              </marker>
              <marker
                id="arrow-emerald"
                viewBox="0 0 10 10"
                refX="5"
                refY="5"
                markerWidth="6"
                markerHeight="6"
                orient="auto-start-reverse"
              >
                <path d="M 0 1 L 10 5 L 0 9 z" fill="#34d399" />
              </marker>

              {/* Line Gradients */}
              <linearGradient
                id="line-human-discussion"
                x1="0%"
                y1="0%"
                x2="0%"
                y2="100%"
              >
                <stop offset="0%" stop-color="#818cf8" />
                <stop offset="100%" stop-color="#38bdf8" />
              </linearGradient>
              <linearGradient
                id="line-human-execution"
                x1="0%"
                y1="0%"
                x2="0%"
                y2="100%"
              >
                <stop offset="0%" stop-color="#818cf8" />
                <stop offset="100%" stop-color="#34d399" />
              </linearGradient>
            </defs>

            {/* Path 1: Human <-> 대화형 AI */}
            <line
              x1="210"
              y1="105"
              x2="122.5"
              y2="220"
              stroke="url(#line-human-discussion)"
              stroke-width="2.5"
              stroke-dasharray="6 4"
              class="animate-dash-discussion"
              marker-start="url(#arrow-cyan)"
              marker-end="url(#arrow-cyan)"
            />

            {/* Path 2: Human <-> 코딩형 AI */}
            <line
              x1="290"
              y1="105"
              x2="377.5"
              y2="220"
              stroke="url(#line-human-execution)"
              stroke-width="2.5"
              stroke-dasharray="6 4"
              class="animate-dash-execution"
              marker-start="url(#arrow-emerald)"
              marker-end="url(#arrow-emerald)"
            />

            {/* Light Data Flow Pulses */}
            <circle r="4.5" fill="#38bdf8">
              <animateMotion
                dur="2.4s"
                repeatCount="indefinite"
                path="M 210 105 L 122.5 220"
              />
            </circle>
            <circle r="3.5" fill="#818cf8">
              <animateMotion
                dur="2.4s"
                begin="1.2s"
                repeatCount="indefinite"
                path="M 122.5 220 L 210 105"
              />
            </circle>

            <circle r="4.5" fill="#34d399">
              <animateMotion
                dur="2.6s"
                repeatCount="indefinite"
                path="M 290 105 L 377.5 220"
              />
            </circle>
            <circle r="3.5" fill="#818cf8">
              <animateMotion
                dur="2.6s"
                begin="1.3s"
                repeatCount="indefinite"
                path="M 377.5 220 L 290 105"
              />
            </circle>

            {/* Node 1 (Top): Human */}
            <g transform="translate(150, 20)">
              <animateTransform
                attributeName="transform"
                type="translate"
                values="150 20; 150 14; 150 20"
                dur="4s"
                repeatCount="indefinite"
              />
              <rect
                x="0"
                y="0"
                width="200"
                height="85"
                rx="20"
                class="hero-human-node"
                fill-opacity="0.95"
                stroke="#6366f1"
                stroke-width="2.5"
              />
              <text
                x="100"
                y="38"
                text-anchor="middle"
                class="hero-node-title"
                font-weight="900"
                font-size="24"
              >
                Human
              </text>
              <text
                x="100"
                y="66"
                text-anchor="middle"
                class="hero-human-copy"
                font-weight="700"
                font-size="18"
              >
                결정하고 검토·커밋
              </text>
            </g>

            {/* Node 2 (Bottom Left): ① 대화형 AI */}
            <g transform="translate(5, 220)">
              <animateTransform
                attributeName="transform"
                type="translate"
                values="5 220; 5 226; 5 220"
                dur="4.8s"
                repeatCount="indefinite"
              />
              <rect
                x="0"
                y="0"
                width="235"
                height="114"
                rx="20"
                class="hero-discussion-node"
                fill-opacity="0.95"
                stroke="#38bdf8"
                stroke-width="2.5"
              />
              <text
                x="117.5"
                y="36"
                text-anchor="middle"
                class="hero-node-title"
                font-weight="900"
                font-size="24"
              >
                ① 대화형 AI
              </text>
              <text
                x="117.5"
                y="62"
                text-anchor="middle"
                class="hero-discussion-copy"
                font-weight="600"
                font-size="16"
              >
                (ChatGPT · Claude)
              </text>
              <text
                x="117.5"
                y="92"
                text-anchor="middle"
                class="hero-discussion-detail"
                font-weight="700"
                font-size="18"
              >
                함께 기획하고 문서 작성
              </text>
            </g>

            {/* Node 3 (Bottom Right): ② 코딩형 AI */}
            <g transform="translate(260, 220)">
              <animateTransform
                attributeName="transform"
                type="translate"
                values="260 220; 260 214; 260 220"
                dur="4.4s"
                repeatCount="indefinite"
              />
              <rect
                x="0"
                y="0"
                width="235"
                height="114"
                rx="20"
                class="hero-execution-node"
                fill-opacity="0.95"
                stroke="#34d399"
                stroke-width="2.5"
              />
              <text
                x="117.5"
                y="36"
                text-anchor="middle"
                class="hero-node-title"
                font-weight="900"
                font-size="24"
              >
                ② 코딩형 AI
              </text>
              <text
                x="117.5"
                y="62"
                text-anchor="middle"
                class="hero-execution-copy"
                font-weight="600"
                font-size="16"
              >
                (Codex · Claude Code)
              </text>
              <text
                x="117.5"
                y="92"
                text-anchor="middle"
                class="hero-execution-detail"
                font-weight="700"
                font-size="18"
              >
                문서와 코드를 함께 수정
              </text>
            </g>

            {/* Bottom Edge Label: 문서 · Git */}
            <g transform="translate(250, 408)">
              <rect
                x="-90"
                y="-22"
                width="180"
                height="44"
                rx="16"
                class="hero-assets-node"
                fill-opacity="0.95"
                stroke="#475569"
                stroke-width="1.5"
              />
              <text
                x="0"
                y="7"
                text-anchor="middle"
                class="hero-assets-copy"
                font-weight="800"
                font-size="20"
                letter-spacing="1"
              >
                문서 · Git
              </text>
            </g>
          </svg>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-human-node {
    fill: #1e1b4b;
  }

  .hero-node-title {
    fill: #ffffff;
  }

  .hero-human-copy {
    fill: #a5b4fc;
  }

  .hero-discussion-node {
    fill: #082f49;
  }

  .hero-discussion-copy {
    fill: #7dd3fc;
  }

  .hero-discussion-detail {
    fill: #bae6fd;
  }

  .hero-execution-node {
    fill: #064e3b;
  }

  .hero-execution-copy {
    fill: #6ee7b7;
  }

  .hero-execution-detail {
    fill: #a7f3d0;
  }

  .hero-assets-node {
    fill: #0f172a;
  }

  .hero-assets-copy {
    fill: #cbd5e1;
  }

  :global(html.light) .hero-human-node {
    fill: #e0e7ff;
  }

  :global(html.light) .hero-node-title {
    fill: #1e1b4b;
  }

  :global(html.light) .hero-human-copy {
    fill: #4338ca;
  }

  :global(html.light) .hero-discussion-node {
    fill: #e0f2fe;
  }

  :global(html.light) .hero-discussion-copy {
    fill: #0369a1;
  }

  :global(html.light) .hero-discussion-detail {
    fill: #075985;
  }

  :global(html.light) .hero-execution-node {
    fill: #d1fae5;
  }

  :global(html.light) .hero-execution-copy {
    fill: #047857;
  }

  :global(html.light) .hero-execution-detail {
    fill: #065f46;
  }

  :global(html.light) .hero-assets-node {
    fill: #f1f5f9;
  }

  :global(html.light) .hero-assets-copy {
    fill: #334155;
  }

  :global(html.light) .hero-diagram {
    background: linear-gradient(135deg, #f1f5ff 0%, #eaf4ff 52%, #eef2ff 100%);
    border-color: rgba(129, 140, 248, 0.28);
    box-shadow: 0 25px 50px -18px rgba(79, 70, 229, 0.18);
  }

  /* Ultra-light Hardware-Accelerated Radial Orbs (Zero Blur Filter, Zero CPU repaint) */
  .bg-radial-cyan {
    background: radial-gradient(
      circle,
      rgba(56, 189, 248, 0.28) 0%,
      rgba(56, 189, 248, 0) 70%
    );
  }

  .bg-radial-indigo {
    background: radial-gradient(
      circle,
      rgba(99, 102, 241, 0.28) 0%,
      rgba(99, 102, 241, 0) 70%
    );
  }

  @keyframes gpu-float-1 {
    0%,
    100% {
      transform: translate3d(0, 0, 0);
    }
    50% {
      transform: translate3d(-80px, 50px, 0);
    }
  }

  @keyframes gpu-float-2 {
    0%,
    100% {
      transform: translate3d(0, 0, 0);
    }
    50% {
      transform: translate3d(90px, -50px, 0);
    }
  }

  .animate-gpu-float-1 {
    will-change: transform;
    animation: gpu-float-1 14s ease-in-out infinite;
  }

  .animate-gpu-float-2 {
    will-change: transform;
    animation: gpu-float-2 16s ease-in-out infinite;
  }

  /* Dash Flow Animation for Connection Lines */
  @keyframes dash-flow {
    from {
      stroke-dashoffset: 20;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  .animate-dash-discussion {
    animation: dash-flow 1.6s linear infinite;
  }

  .animate-dash-execution {
    animation: dash-flow 1.6s linear infinite reverse;
  }
</style>
