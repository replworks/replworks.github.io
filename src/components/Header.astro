---
import DesktopNav from './DesktopNav.astro';
import MobileNav from './MobileNav.astro';
---

<header class="sticky top-0 z-40 border-b border-slate-800/80 bg-[#090d16]/85 backdrop-blur-md">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3.5 sm:px-6 lg:px-8">
    <a href="/" class="flex items-center gap-2.5 group">
      <img
        src="/logo-tight-margin-1024-1024.svg"
        alt="REPL Works"
        class="h-7 w-7 object-contain group-hover:scale-105 transition-transform"
      />
      <span class="text-base font-black tracking-tight text-white group-hover:text-cyan-400 transition-colors">
        REPL Works
      </span>
      <span class="px-2 py-0.5 text-[10px] font-mono font-bold rounded-full bg-cyan-950/80 text-cyan-400 border border-cyan-800/50">
        v2.0
      </span>
    </a>
    <DesktopNav />
    <MobileNav />
  </div>
</header>
