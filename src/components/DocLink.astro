---
// src/components/DocLink.astro
import { formatUrl } from '../utils/url';

interface Props {
  href: string;
  text?: string;
  downloadHref?: string;
}
const { href, text = '표준 문서 보기', downloadHref } = Astro.props;
const formattedHref = formatUrl(href);
---

<div class="my-4 flex flex-wrap gap-2.5">
  <a
    href={formattedHref}
    class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-xs font-bold text-slate-800 dark:text-slate-200 shadow-sm no-underline transition-all hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-slate-950 dark:hover:text-white hover:border-slate-400 dark:hover:border-slate-700 group"
  >
    <span>{text}</span>
    <svg
      class="h-3.5 w-3.5 text-slate-500 dark:text-slate-400 transition-transform group-hover:translate-x-0.5 group-hover:text-cyan-600 dark:group-hover:text-cyan-400"
      fill="none"
      viewBox="0 0 24 24"
      stroke-width="3"
      stroke="currentColor"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"
      ></path>
    </svg>
  </a>
  {downloadHref && (
    <a
      href={downloadHref}
      download
      class="group inline-flex items-center gap-1.5 rounded-xl border border-cyan-300 dark:border-cyan-800/80 bg-cyan-50 dark:bg-cyan-950/60 px-3.5 py-2 text-xs font-bold text-cyan-700 dark:text-cyan-300 no-underline transition-all hover:bg-cyan-100 dark:hover:bg-cyan-900/80 hover:text-cyan-950 dark:hover:text-white"
    >
      <svg
        class="h-3.5 w-3.5 transition-transform group-hover:translate-y-0.5"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="2.5"
        stroke="currentColor"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M7.5 10.5L12 15m0 0l4.5-4.5M12 15V3"
        ></path>
      </svg>
      <span>Markdown 다운로드</span>
    </a>
  )}
</div>
