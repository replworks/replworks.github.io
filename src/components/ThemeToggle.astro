---
interface Props {
  variant?: 'desktop' | 'mobile';
}

const { variant = 'desktop' } = Astro.props;
---

{variant === 'desktop' ? (
  <div class="relative inline-block text-left theme-toggle-container">
    <button
      type="button"
      data-theme-dropdown-trigger
      aria-label="테마 선택"
      aria-expanded="false"
      class="inline-flex items-center gap-1.5 rounded-lg border border-slate-300/80 bg-white/80 px-2.5 py-1.5 text-xs font-semibold text-slate-700 shadow-sm transition-all hover:border-slate-400 hover:bg-slate-100 dark:border-slate-800 dark:bg-slate-900/80 dark:text-slate-300 dark:hover:border-slate-700 dark:hover:bg-slate-800 backdrop-blur cursor-pointer"
    >
      <span data-theme-icon-active class="flex items-center text-sm">
        💻
      </span>
      <span
        data-theme-label-active
        class="hidden lg:inline text-xs font-semibold"
      >
        시스템
      </span>
      <svg
        class="h-3.5 w-3.5 text-slate-500"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M19 9l-7 7-7-7"
        />
      </svg>
    </button>

    <div
      data-theme-dropdown-menu
      class="hidden absolute right-0 mt-2 w-36 rounded-xl border border-slate-200 bg-white/95 p-1.5 shadow-xl backdrop-blur-xl dark:border-slate-800 dark:bg-slate-900/95 z-50 transition-all"
    >
      <button
        type="button"
        data-theme-option="system"
        class="flex w-full items-center justify-between rounded-lg px-2.5 py-1.5 text-xs font-medium text-slate-700 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800 transition-colors cursor-pointer"
      >
        <span class="flex items-center gap-2">
          <span>💻</span> 시스템 모드
        </span>
        <span data-theme-check="system" class="text-cyan-500 hidden font-bold">
          ✓
        </span>
      </button>
      <button
        type="button"
        data-theme-option="light"
        class="flex w-full items-center justify-between rounded-lg px-2.5 py-1.5 text-xs font-medium text-slate-700 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800 transition-colors cursor-pointer"
      >
        <span class="flex items-center gap-2">
          <span>☀️</span> 라이트 모드
        </span>
        <span data-theme-check="light" class="text-cyan-500 hidden font-bold">
          ✓
        </span>
      </button>
      <button
        type="button"
        data-theme-option="dark"
        class="flex w-full items-center justify-between rounded-lg px-2.5 py-1.5 text-xs font-medium text-slate-700 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800 transition-colors cursor-pointer"
      >
        <span class="flex items-center gap-2">
          <span>🌙</span> 다크 모드
        </span>
        <span data-theme-check="dark" class="text-cyan-500 hidden font-bold">
          ✓
        </span>
      </button>
    </div>
  </div>
) : (
  <div class="mt-3 border-t border-slate-200 pt-3 dark:border-slate-800">
    <p class="mb-2 text-[10px] font-mono font-bold uppercase tracking-wider text-slate-400">
      테마 설정
    </p>
    <div class="grid grid-cols-3 gap-1 rounded-xl bg-slate-100 p-1 dark:bg-slate-900 border border-slate-200 dark:border-slate-800">
      <button
        type="button"
        data-theme-option="system"
        class="flex flex-col items-center gap-1 rounded-lg py-1.5 text-[11px] font-medium text-slate-600 dark:text-slate-400 transition-all hover:text-slate-900 dark:hover:text-white cursor-pointer"
      >
        <span class="text-sm">💻</span>
        <span>시스템</span>
      </button>
      <button
        type="button"
        data-theme-option="light"
        class="flex flex-col items-center gap-1 rounded-lg py-1.5 text-[11px] font-medium text-slate-600 dark:text-slate-400 transition-all hover:text-slate-900 dark:hover:text-white cursor-pointer"
      >
        <span class="text-sm">☀️</span>
        <span>라이트</span>
      </button>
      <button
        type="button"
        data-theme-option="dark"
        class="flex flex-col items-center gap-1 rounded-lg py-1.5 text-[11px] font-medium text-slate-600 dark:text-slate-400 transition-all hover:text-slate-900 dark:hover:text-white cursor-pointer"
      >
        <span class="text-sm">🌙</span>
        <span>다크</span>
      </button>
    </div>
  </div>
)}

<script>
  const applyThemeSetting = (themeSetting: string) => {
    localStorage.setItem('theme', themeSetting);
    const systemDark = window.matchMedia(
      '(prefers-color-scheme: dark)',
    ).matches;
    const resolved =
      themeSetting === 'system'
        ? systemDark
          ? 'dark'
          : 'light'
        : themeSetting;

    document.documentElement.setAttribute('data-theme', resolved);
    document.documentElement.setAttribute('data-theme-setting', themeSetting);

    if (resolved === 'dark') {
      document.documentElement.classList.add('dark');
      document.documentElement.classList.remove('light');
    } else {
      document.documentElement.classList.add('light');
      document.documentElement.classList.remove('dark');
    }

    updateUIState(themeSetting);
  };

  const updateUIState = (currentThemeSetting: string) => {
    const icons: Record<string, string> = {
      system: '💻',
      light: '☀️',
      dark: '🌙',
    };
    const labels: Record<string, string> = {
      system: '시스템',
      light: '라이트',
      dark: '다크',
    };

    // Desktop UI Update
    document.querySelectorAll('[data-theme-icon-active]').forEach((el) => {
      el.textContent = icons[currentThemeSetting] || '💻';
    });
    document.querySelectorAll('[data-theme-label-active]').forEach((el) => {
      el.textContent = labels[currentThemeSetting] || '시스템';
    });

    document.querySelectorAll('[data-theme-check]').forEach((el) => {
      const target = el.getAttribute('data-theme-check');
      if (target === currentThemeSetting) {
        el.classList.remove('hidden');
      } else {
        el.classList.add('hidden');
      }
    });

    // Mobile UI Update
    document.querySelectorAll('button[data-theme-option]').forEach((btn) => {
      const option = btn.getAttribute('data-theme-option');
      if (option === currentThemeSetting) {
        btn.classList.add(
          'bg-white',
          'text-cyan-600',
          'shadow-sm',
          'dark:bg-slate-800',
          'dark:text-cyan-400',
          'font-bold',
        );
        btn.classList.remove('text-slate-600', 'dark:text-slate-400');
      } else {
        btn.classList.remove(
          'bg-white',
          'text-cyan-600',
          'shadow-sm',
          'dark:bg-slate-800',
          'dark:text-cyan-400',
          'font-bold',
        );
        btn.classList.add('text-slate-600', 'dark:text-slate-400');
      }
    });
  };

  document.addEventListener('DOMContentLoaded', () => {
    const stored = localStorage.getItem('theme') || 'system';
    updateUIState(stored);

    // Option Click Handlers
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement | null;
      if (!target) return;

      const optionBtn = target.closest('button[data-theme-option]');
      if (optionBtn) {
        const option = optionBtn.getAttribute('data-theme-option');
        if (option) {
          applyThemeSetting(option);
          document
            .querySelectorAll('[data-theme-dropdown-menu]')
            .forEach((menu) => {
              menu.classList.add('hidden');
            });
        }
        return;
      }

      const trigger = target.closest('button[data-theme-dropdown-trigger]');
      if (trigger) {
        const container = trigger.closest('.theme-toggle-container');
        const menu = container?.querySelector('[data-theme-dropdown-menu]');
        if (menu) {
          const isHidden = menu.classList.contains('hidden');
          document
            .querySelectorAll('[data-theme-dropdown-menu]')
            .forEach((m) => m.classList.add('hidden'));
          if (isHidden) {
            menu.classList.remove('hidden');
          }
        }
        return;
      }

      if (!target.closest('.theme-toggle-container')) {
        document
          .querySelectorAll('[data-theme-dropdown-menu]')
          .forEach((menu) => {
            menu.classList.add('hidden');
          });
      }
    });

    window
      .matchMedia('(prefers-color-scheme: dark)')
      .addEventListener('change', () => {
        const current = localStorage.getItem('theme') || 'system';
        if (current === 'system') {
          applyThemeSetting('system');
        }
      });
  });
</script>
