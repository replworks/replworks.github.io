---
import SiteLayout from './SiteLayout.astro';
const { title = 'Document', description = 'Document content placeholder.' } =
  Astro.props;
---

<SiteLayout title={title} description={description}>
  <div
    class="w-full glass-card rounded-3xl p-6 sm:p-10 border border-slate-800/80 shadow-2xl"
  >
    <header class="mb-8 border-b border-slate-800 pb-6">
      <p
        class="text-xs font-mono font-bold uppercase tracking-[0.3em] text-cyan-400"
      >
        DOCUMENT SPECIFICATION
      </p>
      <h1
        class="mt-3 break-all text-3xl font-black tracking-tight text-white sm:text-4xl"
      >
        {title}
      </h1>
      <p class="mt-3 max-w-3xl text-sm sm:text-base leading-relaxed text-slate-400">
        {description}
      </p>
    </header>
    <div class="prose prose-invert prose-slate max-w-none space-y-6 text-slate-300">
      <slot />
    </div>
  </div>
</SiteLayout>
