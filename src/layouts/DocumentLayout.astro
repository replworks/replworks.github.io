---
import SiteLayout from './SiteLayout.astro';
const {
  title = 'Document',
  label = 'DOCUMENT SPECIFICATION',
  description = 'Document content placeholder.',
  ogImage = '/og/index.png',
} = Astro.props;
---

<SiteLayout title={title} description={description} ogImage={ogImage}>
  <div class="w-full sm:glass-card sm:rounded-3xl p-0 sm:p-10 sm:border sm:border-slate-200 dark:sm:border-slate-800/80 sm:shadow-2xl">
    <header class="px-4 pt-6 mb-8 border-b border-slate-200 dark:border-slate-800 pb-6 sm:px-0 sm:pt-0">
      <p class="text-xs font-mono font-bold uppercase tracking-[0.3em] text-cyan-600 dark:text-cyan-400">
        {label}
      </p>
      <h1 class="mt-3 break-all text-3xl font-black tracking-tight text-slate-900 dark:text-white sm:text-4xl">
        {title}
      </h1>
      <p class="mt-3 max-w-3xl text-sm sm:text-base leading-relaxed text-slate-600 dark:text-slate-400">
        {description}
      </p>
    </header>
    <div class="px-4 pb-6 prose prose-slate dark:prose-invert max-w-none space-y-6 text-slate-700 dark:text-slate-300 sm:px-0 sm:pb-0 prose-headings:text-slate-900 dark:prose-headings:text-slate-100 prose-h2:border-b prose-h2:border-slate-200 dark:prose-h2:border-slate-800/80 prose-h2:pb-2.5 prose-h2:text-xl prose-h2:font-extrabold prose-h2:text-cyan-700 dark:prose-h2:text-cyan-300 prose-hr:border-slate-200 dark:prose-hr:border-slate-800/60">
      <slot />
    </div>
  </div>
</SiteLayout>
