---
import SiteLayout from './SiteLayout.astro';
const { title = 'Document', description = 'Document content placeholder.' } =
  Astro.props;
---

<SiteLayout title={title} description={description}>
  <div class="w-full sm:glass-card sm:rounded-3xl p-0 sm:p-10 sm:border sm:border-slate-800/80 sm:shadow-2xl">
    <header class="px-4 pt-6 mb-8 border-b border-slate-800 pb-6 sm:px-0 sm:pt-0">
      <p class="text-xs font-mono font-bold uppercase tracking-[0.3em] text-cyan-400">
        DOCUMENT SPECIFICATION
      </p>
      <h1 class="mt-3 break-all text-3xl font-black tracking-tight text-white sm:text-4xl">
        {title}
      </h1>
      <p class="mt-3 max-w-3xl text-sm sm:text-base leading-relaxed text-slate-400">
        {description}
      </p>
    </header>
    <div class="px-4 pb-6 prose prose-invert prose-slate max-w-none space-y-6 text-slate-300 sm:px-0 sm:pb-0">
      <slot />
    </div>
  </div>
</SiteLayout>
