---
import SiteLayout from './SiteLayout.astro';

const { title, description } = Astro.props;
---

<SiteLayout title={title} description={description}>
  <div class="w-full glass-card rounded-3xl p-6 sm:p-10 border border-slate-800/80 shadow-2xl">
    <header class="mb-8 border-b border-slate-800 pb-6">
      <h1 class="break-all text-3xl font-black tracking-tight text-white sm:text-4xl">
        {title}
      </h1>
      <p class="mt-3 max-w-3xl text-sm sm:text-base leading-relaxed text-slate-400">
        {description}
      </p>
    </header>
    <div class="max-w-none text-slate-300">
      <slot />
    </div>
  </div>
</SiteLayout>
